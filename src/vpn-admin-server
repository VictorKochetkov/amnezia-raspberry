def parse_domains(path):
    groups = []
    current = {"name": "General", "domains": []}

    with open(path, "r", encoding="utf-8") as file:
        for raw_line in file:
            line = raw_line.strip()
            if not line:
                continue
            if line.startswith("#"):
                name = line[1:].strip() or "General"
                if current["domains"]:
                    groups.append(current)
                current = {"name": name, "domains": []}
                continue
            current["domains"].append(line)

    if current["domains"]:
        groups.append(current)

    return groups


def resolve_command(candidates):
    for candidate in candidates:
        if candidate.startswith("/") and os.path.exists(candidate):
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def read_cpu_times():
    try:
        with open("/proc/stat", "r", encoding="utf-8") as file:
            line = file.readline()
    except OSError:
        return None

    if not line.startswith("cpu "):
        return None

    values = [int(value) for value in line.split()[1:]]
    if len(values) < 4:
        return None

    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return {"total": sum(values), "idle": idle}


def read_load_average():
    try:
        with open("/proc/loadavg", "r", encoding="utf-8") as file:
            values = file.read().split()[:3]
        return {
            "1m": float(values[0]),
            "5m": float(values[1]),
            "15m": float(values[2]),
        }
    except (OSError, ValueError, IndexError):
        return {"1m": None, "5m": None, "15m": None}


def read_cpu_status():
    global LAST_CPU_TIMES

    current = read_cpu_times()
    percent = None
    if current and LAST_CPU_TIMES:
        total_delta = current["total"] - LAST_CPU_TIMES["total"]
        idle_delta = current["idle"] - LAST_CPU_TIMES["idle"]
        if total_delta > 0:
            percent = max(0.0, min(100.0, (1 - idle_delta / total_delta) * 100))
    if current:
        LAST_CPU_TIMES = current

    load_average = read_load_average()
    cores = os.cpu_count() or 1
    if percent is None and load_average["1m"] is not None:
        percent = max(0.0, min(100.0, (load_average["1m"] / cores) * 100))

    return {
        "percent": round(percent, 1) if percent is not None else None,
        "load_average": load_average,
        "cores": cores,
    }


def read_temperature_status():
    paths = [TEMP_FILE, "/sys/class/hwmon/hwmon0/temp1_input"]
    for path in dict.fromkeys(paths):
        try:
            with open(path, "r", encoding="utf-8") as file:
                raw_value = file.read().strip()
            value = float(raw_value)
        except (OSError, ValueError):
            continue

        if value > 1000:
            value /= 1000
        return {"celsius": round(value, 1), "source": path}

    return {"celsius": None, "source": None}


def read_power_status():
    vcgencmd = resolve_command(("vcgencmd", "/usr/bin/vcgencmd", "/opt/vc/bin/vcgencmd"))
    if not vcgencmd:
        return {"available": False, "error": "vcgencmd not found"}

    try:
        result = subprocess.run(
            [vcgencmd, "get_throttled"],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"available": False, "error": str(exc)}

    raw = (result.stdout or result.stderr or "").strip()
    if result.returncode != 0:
        return {"available": False, "raw": raw, "error": raw or "vcgencmd failed"}

    try:
        value = int(raw.split("=", 1)[1], 16)
    except (IndexError, ValueError):
        return {"available": False, "raw": raw, "error": "unexpected vcgencmd output"}

    flags = []
    if value & 0x1:
        flags.append("under-voltage now")
    if value & 0x2:
        flags.append("frequency capped now")
    if value & 0x4:
        flags.append("throttled now")
    if value & 0x8:
        flags.append("temperature limit now")
    if value & 0x10000:
        flags.append("under-voltage occurred")
    if value & 0x20000:
        flags.append("frequency capped occurred")
    if value & 0x40000:
        flags.append("throttled occurred")
    if value & 0x80000:
        flags.append("temperature limit occurred")

    return {
        "available": True,
        "raw": raw,
        "value": value,
        "flags": flags,
        "throttled": bool(value & 0xF),
        "was_throttled": bool(value & 0xF0000),
    }


def load_system_history():
    try:
        with open(SYSTEM_HISTORY_FILE, "r", encoding="utf-8") as file:
            payload = json.load(file)
        if isinstance(payload, dict):
            return {
                "cpu": payload.get("cpu") if isinstance(payload.get("cpu"), list) else [],
                "temperature": payload.get("temperature") if isinstance(payload.get("temperature"), list) else [],
                "power": payload.get("power") if isinstance(payload.get("power"), list) else [],
            }
    except (OSError, json.JSONDecodeError):
        pass
    return {"cpu": [], "temperature": [], "power": []}


def save_system_history(history):
    try:
        directory = os.path.dirname(SYSTEM_HISTORY_FILE)
        os.makedirs(directory, mode=0o755, exist_ok=True)
        tmp_path = SYSTEM_HISTORY_FILE + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as file:
            json.dump(history, file, ensure_ascii=False)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, SYSTEM_HISTORY_FILE)
    except OSError:
        pass


def update_system_history(cpu, temperature, power):
    history = load_system_history()
    now = int(time.time())
    cutoff = now - SYSTEM_HISTORY_SECONDS

    if isinstance(cpu.get("percent"), (int, float)):
        history["cpu"].append({"ts": now, "percent": cpu["percent"]})
    if isinstance(temperature.get("celsius"), (int, float)):
        history["temperature"].append({"ts": now, "celsius": temperature["celsius"]})
    if power.get("available"):
        history["power"].append({
            "ts": now,
            "bad": bool(power.get("throttled")),
            "event": bool(power.get("was_throttled")),
            "raw": power.get("raw"),
        })

    history["cpu"] = [item for item in history["cpu"] if item.get("ts", now) >= cutoff][-SYSTEM_HISTORY_LIMIT:]
    history["temperature"] = [item for item in history["temperature"] if item.get("ts", now) >= cutoff][-SYSTEM_HISTORY_LIMIT:]
    history["power"] = [item for item in history["power"] if item.get("ts", now) >= cutoff][-SYSTEM_HISTORY_LIMIT:]
    save_system_history(history)
    return history


def read_system_snapshot():
    try:
        with open(SYSTEM_FILE, "r", encoding="utf-8") as file:
            payload = json.load(file)
        system = payload.get("system") if isinstance(payload, dict) else None
        return system if isinstance(system, dict) else None
    except (OSError, json.JSONDecodeError):
        return None


def read_system_health():
    snapshot = read_system_snapshot()
    if snapshot:
        return snapshot

    cpu = read_cpu_status()
    temperature = read_temperature_status()
    power = read_power_status()
    return {
        "cpu": cpu,
        "temperature": temperature,
        "power": power,
        "history": load_system_history(),
    }


def parse_iw_stations(output):
    stations = []
    current = None

    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("Station ") and " (on " in line:
            if current:
                stations.append(current)
            current = {"mac": line.split()[1]}
            continue

        if not current or ":" not in line:
            continue

        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip()
        if key in ("inactive time", "connected time", "rx bitrate", "tx bitrate"):
            current[key.replace(" ", "_")] = value

    if current:
        stations.append(current)

    return stations


def read_wifi_clients():
    iw = resolve_command(("/usr/sbin/iw", "/sbin/iw", "iw"))
    if not iw:
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": "iw not found"}

    try:
        result = subprocess.run(
            [iw, "dev", WIFI_IFACE, "station", "dump"],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": str(exc)}

    if result.returncode != 0:
        error = (result.stderr or result.stdout).strip() or "iw failed"
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": error}

    stations = parse_iw_stations(result.stdout)
    return {"interface": WIFI_IFACE, "count": len(stations), "stations": stations}


def read_wifi_ap_state():
