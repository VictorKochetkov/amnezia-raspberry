def read_wifi_ap_current():
    iw = resolve_command(("/usr/sbin/iw", "/sbin/iw", "iw"))
    if not iw:
        return {"interface": WIFI_IFACE, "error": "iw not found"}

    try:
        result = subprocess.run(
            [iw, "dev", WIFI_IFACE, "info"],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"interface": WIFI_IFACE, "error": str(exc)}

    current = {"interface": WIFI_IFACE}
    if result.returncode != 0:
        current["error"] = (result.stderr or result.stdout).strip() or "iw failed"
        return current

    for raw_line in result.stdout.splitlines():
        line = raw_line.strip()
        if line.startswith("ssid "):
            current["ssid"] = line.split(" ", 1)[1].strip()
        elif line.startswith("type "):
            current["type"] = line.split(" ", 1)[1].strip()
        elif line.startswith("channel "):
            current["channel_text"] = line
            parts = line.split()
            if len(parts) > 1:
                try:
                    current["channel"] = int(parts[1])
                except ValueError:
                    pass
            if "width:" in line:
                width = line.split("width:", 1)[1].split(",", 1)[0].strip()
                current["width"] = width
                if width.endswith("MHz"):
                    try:
                        current["width_mhz"] = int(width[:-3].strip())
                    except ValueError:
                        pass

    return current


def read_wifi_ap_status():
