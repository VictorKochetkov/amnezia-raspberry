  <script>
    const statusDot = document.getElementById("status-dot");
    const statusText = document.getElementById("status-text");
    const fileMeta = document.getElementById("file-meta");
    const groupsNode = document.getElementById("groups");
    const domainsTotal = document.getElementById("domains-total");
    const groupsTotal = document.getElementById("groups-total");
    const clientsTotal = document.getElementById("clients-total");
    const trafficTotal = document.getElementById("traffic-total");
    const trafficVpnBytes = document.getElementById("traffic-vpn-bytes");
    const trafficDirectBytes = document.getElementById("traffic-direct-bytes");
    const trafficVpnPercent = document.getElementById("traffic-vpn-percent");
    const trafficDirectPercent = document.getElementById("traffic-direct-percent");
    const trafficVpnArc = document.getElementById("traffic-vpn-arc");
    const trafficDirectArc = document.getElementById("traffic-direct-arc");
    const tabs = Array.from(document.querySelectorAll("[data-tab]"));
    const views = {
      domains: document.getElementById("domains-view"),
      vpn: document.getElementById("vpn-view")
    };
    const vpnMeta = document.getElementById("vpn-meta");
    const configList = document.getElementById("config-list");
    const uploadForm = document.getElementById("upload-form");
    const configFiles = document.getElementById("config-files");

    function setStatus(kind, text, title = "") {
      statusDot.className = "dot " + kind;
      statusText.textContent = text;
      statusText.title = title;
    }

    function render(data) {
      domainsTotal.textContent = data.total;
      groupsTotal.textContent = data.groups.length;
      fileMeta.textContent = data.path;

      if (!data.groups.length) {
        groupsNode.innerHTML = '<div class="empty">No domains found.</div>';
        return;
      }

      groupsNode.innerHTML = data.groups.map((group) => {
        const domains = group.domains.map((domain) => {
          return `<div class="domain">${escapeHtml(domain)}</div>`;
        }).join("");

        return `<details class="group">
          <summary class="group-head">
            <span class="group-main">
              <span class="chevron" aria-hidden="true"></span>
              <span class="group-title">${escapeHtml(group.name)}</span>
            </span>
            <span class="count">${group.domains.length}</span>
          </summary>
          <div class="domain-list">${domains}</div>
        </details>`;
      }).join("");
    }

    function renderStatus(data) {
      clientsTotal.textContent = data.clients.count;
      clientsTotal.title = data.clients.interface;
      renderVpnConnection(data.vpn_status);
      renderTraffic(data.traffic);
    }

    function renderVpnConnection(status) {
      if (!status) {
        setStatus("error", "VPN unknown");
        return;
      }

      const kind = {
        connected: "ready",
        connecting: "connecting",
        disconnected: "disconnected",
        error: "error"
      }[status.state] || "error";

      const details = [
        status.service?.name,
        status.service?.active ? `service: ${status.service.active}` : "",
        status.interface?.exists === false ? `${status.interface.name} missing` : "",
        status.latest_handshake ? `handshake: ${status.latest_handshake}` : "",
        status.endpoint ? `endpoint: ${status.endpoint}` : "",
        status.error || ""
      ].filter(Boolean).join(" · ");

      setStatus(kind, status.label || "VPN unknown", details);
    }

    function renderTraffic(traffic) {
      if (!traffic) return;
      const vpn = traffic.vpn?.bytes || 0;
      const direct = traffic.direct?.bytes || 0;
      const total = vpn + direct;
      const vpnPercent = total ? Math.round((vpn / total) * 100) : 0;
      const directPercent = total ? 100 - vpnPercent : 0;

      trafficTotal.textContent = formatBytes(total);
      trafficVpnBytes.textContent = formatBytes(vpn);
      trafficDirectBytes.textContent = formatBytes(direct);
      trafficVpnPercent.textContent = `${vpnPercent}%`;
      trafficDirectPercent.textContent = `${directPercent}%`;
      trafficVpnArc.setAttribute("stroke-dasharray", `${vpnPercent} ${100 - vpnPercent}`);
      trafficDirectArc.setAttribute("stroke-dasharray", `${directPercent} ${100 - directPercent}`);
      trafficDirectArc.setAttribute("stroke-dashoffset", String(-vpnPercent));
    }

    function formatBytes(bytes) {
      const units = ["B", "KB", "MB", "GB", "TB"];
      let value = Number(bytes) || 0;
      let index = 0;
      while (value >= 1024 && index < units.length - 1) {
        value /= 1024;
        index += 1;
      }
      const precision = value >= 10 || index === 0 ? 0 : 1;
      return `${value.toFixed(precision)} ${units[index]}`;
    }

    function renderVpn(data) {
      if (data.enabled === false) {
        vpnMeta.textContent = "VPN management disabled";
        configList.innerHTML = `<div class="empty">${escapeHtml(data.error || "VPN config management is not enabled.")}</div>`;
        return;
      }

      vpnMeta.textContent = data.active ? `Active: ${data.active}` : "No active saved profile";

      if (!data.profiles.length) {
        configList.innerHTML = '<div class="empty">No VPN configs uploaded.</div>';
        return;
      }

      configList.innerHTML = data.profiles.map((profile) => {
        const active = profile.active ? '<span class="active-pill">active</span>' : '';
        const date = new Date(profile.mtime * 1000).toLocaleString();
        const size = Math.max(1, Math.round(profile.size / 1024));
        return `<article class="config-row">
          <div>
            <h3 class="config-name">${escapeHtml(profile.name)} ${active}</h3>
            <div class="config-sub">${size} KB · ${escapeHtml(date)}</div>
          </div>
          <div class="config-actions">
            <button class="button primary" type="button" data-action="select" data-name="${escapeHtml(profile.name)}" ${profile.active ? "disabled" : ""}>Select</button>
            <button class="button danger" type="button" data-action="delete" data-name="${escapeHtml(profile.name)}" ${profile.active ? "disabled" : ""}>Delete</button>
          </div>
        </article>`;
      }).join("");
    }

    function escapeHtml(value) {
      return value.replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[char]);
    }

    function loadDomains() {
      return fetch("/admin/api/domains", { cache: "no-store" })
      .then((response) => {
        if (!response.ok) throw new Error("HTTP " + response.status);
        return response.json();
      })
      .then((data) => {
        render(data);
      })
      .catch((error) => {
        groupsNode.innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
        setStatus("error", "Error");
      });
    }

    function loadStatus() {
      return fetch("/admin/api/status", { cache: "no-store" })
        .then((response) => {
          if (!response.ok) throw new Error("HTTP " + response.status);
          return response.json();
        })
        .then(renderStatus)
        .catch(() => {
          clientsTotal.textContent = "-";
          setStatus("error", "VPN status error");
        });
    }

    function loadVpn() {
      return fetch("/admin/api/vpn-configs", { cache: "no-store" })
        .then((response) => {
          if (!response.ok) throw new Error("HTTP " + response.status);
          return response.json();
        })
        .then(renderVpn)
        .catch((error) => {
          configList.innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
        });
    }

    function postJson(url, payload) {
      return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      }).then((response) => response.json().then((data) => {
        if (!response.ok || data.ok === false) throw new Error(data.error || "Request failed");
        return data;
      }));
    }

    function tabFromHash() {
      const tab = window.location.hash.replace(/^#/, "");
      return views[tab] ? tab : "domains";
    }

    function setTab(target, updateHash = true) {
      if (!views[target]) target = "domains";
      tabs.forEach((item) => item.classList.toggle("active", item.dataset.tab === target));
      Object.entries(views).forEach(([name, view]) => view.classList.toggle("hidden", name !== target));
      if (target === "vpn") loadVpn();
      if (updateHash && window.location.hash !== `#${target}`) {
        window.location.hash = target;
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        setTab(tab.dataset.tab);
      });
    });

    window.addEventListener("hashchange", () => {
      setTab(tabFromHash(), false);
    });

    configList.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-action]");
      if (!button) return;
      const name = button.dataset.name;
      button.disabled = true;
      const action = button.dataset.action;
      const url = action === "select" ? "/admin/api/vpn-configs/select" : "/admin/api/vpn-configs/delete";
      postJson(url, { name })
        .then(loadVpn)
        .catch((error) => {
          vpnMeta.textContent = error.message;
          loadVpn();
        });
    });

    uploadForm.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!configFiles.files.length) return;
      const formData = new FormData();
      Array.from(configFiles.files).forEach((file) => formData.append("configs", file, file.name));
      uploadForm.querySelector("button").disabled = true;
      fetch("/admin/api/vpn-configs/upload", { method: "POST", body: formData })
        .then((response) => response.json().then((data) => {
          if (!response.ok || data.ok === false) throw new Error(data.error || "Upload failed");
          return data;
        }))
        .then((data) => {
          vpnMeta.textContent = `Uploaded ${data.imported.length} config${data.imported.length === 1 ? "" : "s"}`;
          configFiles.value = "";
          return loadVpn();
        })
        .catch((error) => {
          vpnMeta.textContent = error.message;
        })
        .finally(() => {
          uploadForm.querySelector("button").disabled = false;
        });
    });

    loadDomains();
    loadStatus();
    setTab(tabFromHash(), false);
    setInterval(loadStatus, 5000);
  </script>
</body>
</html>
"""


def parse_domains(path):
    groups = []
    current = {"name": "General", "domains": []}

    with open(path, "r", encoding="utf-8") as file:
        for raw_line in file:
            line = raw_line.strip()
            if not line:
                continue
            if line.startswith("#"):
                name = line[1:].strip() or "General"
                if current["domains"]:
                    groups.append(current)
                current = {"name": name, "domains": []}
                continue
            current["domains"].append(line)

    if current["domains"]:
        groups.append(current)

    return groups


def resolve_command(candidates):
    for candidate in candidates:
        if candidate.startswith("/") and os.path.exists(candidate):
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def parse_iw_stations(output):
    stations = []
    current = None

    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("Station ") and " (on " in line:
            if current:
                stations.append(current)
            current = {"mac": line.split()[1]}
            continue

        if not current or ":" not in line:
            continue

        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip()
        if key in ("inactive time", "connected time", "rx bitrate", "tx bitrate"):
            current[key.replace(" ", "_")] = value

    if current:
        stations.append(current)

    return stations


def read_wifi_clients():
    iw = resolve_command(("/usr/sbin/iw", "/sbin/iw", "iw"))
    if not iw:
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": "iw not found"}

    try:
        result = subprocess.run(
            [iw, "dev", WIFI_IFACE, "station", "dump"],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": str(exc)}

    if result.returncode != 0:
        error = (result.stderr or result.stdout).strip() or "iw failed"
        return {"interface": WIFI_IFACE, "count": 0, "stations": [], "error": error}

    stations = parse_iw_stations(result.stdout)
    return {"interface": WIFI_IFACE, "count": len(stations), "stations": stations}


def run_helper(args, timeout=90, input_data=None):
    command = ["sudo", "-n", VPN_ADMIN_HELPER] + args
    try:
        result = subprocess.run(
            command,
            input=input_data,
            check=False,
            capture_output=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)}

    stdout = (result.stdout or b"").decode("utf-8", "replace")
    stderr = (result.stderr or b"").decode("utf-8", "replace")
    output = stdout.strip()
    try:
        payload = json.loads(output) if output else {}
    except json.JSONDecodeError:
        payload = {"ok": False, "error": output or (stderr or "Helper failed").strip()}

    if result.returncode != 0 and payload.get("ok") is not False:
        payload["ok"] = False
        payload["error"] = payload.get("error") or (stderr or "Helper failed").strip()

    return payload


def zero_traffic():
    return {
        "vpn": {"bytes": 0, "packets": 0},
        "direct": {"bytes": 0, "packets": 0},
        "total_bytes": 0,
    }


def unknown_vpn_status(error):
    return {
        "state": "error",
        "label": "VPN unknown",
        "service": {"name": "awg-quick@awg0.service", "active": "unknown", "failed": "unknown"},
        "interface": {"name": "awg0", "exists": False},
        "endpoint": None,
        "latest_handshake": None,
        "latest_handshake_seconds": None,
        "transfer": None,
        "stale_after_seconds": None,
        "error": error,
    }


def read_traffic_snapshot():
    try:
        with open(TRAFFIC_FILE, "r", encoding="utf-8") as file:
            payload = json.load(file)
    except (OSError, json.JSONDecodeError):
        return None

    traffic = payload.get("traffic")
    if not isinstance(traffic, dict):
        return None
    return traffic


def read_vpn_status_snapshot():
    try:
        with open(STATUS_FILE, "r", encoding="utf-8") as file:
            payload = json.load(file)
    except (OSError, json.JSONDecodeError):
        return None

    status = payload.get("vpn_status")
    if not isinstance(status, dict):
        return None
    return status


def management_disabled_message():
    return "VPN config management is not available. Redeploy the admin package to install the VPN helper."


def parse_multipart_files(headers, body):
    content_type = headers.get("Content-Type", "")
    if "multipart/form-data" not in content_type:
        raise ValueError("Expected multipart/form-data")

    message_bytes = (
        ("Content-Type: %s\r\n" % content_type).encode("utf-8")
        + b"MIME-Version: 1.0\r\n\r\n"
        + body
    )
    message = email.message_from_bytes(message_bytes, policy=email.policy.default)
    files = []

    if not message.is_multipart():
        raise ValueError("Upload body is not multipart")

    for part in message.iter_parts():
        filename = part.get_filename()
        if not filename:
            continue
        payload = part.get_payload(decode=True) or b""
        if payload:
            files.append((filename, payload))

    return files


class AdminHandler(BaseHTTPRequestHandler):
    server_version = "VpnAdmin/0.1"

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/admin" or path == "/admin/":
            self.send_html(PAGE)
            return
        if path == "/admin/api/domains":
            self.send_domains()
            return
        if path == "/admin/api/status":
            self.send_status()
            return
        if path == "/admin/api/vpn-configs":
            self.send_vpn_configs()
            return
        self.send_error(404)

    def do_POST(self):
        path = urlparse(self.path).path
        if path == "/admin/api/vpn-configs/upload":
            self.upload_vpn_configs()
            return
        if path == "/admin/api/vpn-configs/select":
            self.select_vpn_config()
            return
        if path == "/admin/api/vpn-configs/delete":
            self.delete_vpn_config()
            return
        self.send_error(404)

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args))

    def send_html(self, body):
        data = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, status, payload):
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def read_body(self, limit):
        length = int(self.headers.get("Content-Length", "0") or "0")
        if length > limit:
            raise ValueError("Request body is too large")
        return self.rfile.read(length)

    def read_json_payload(self):
        body = self.read_body(64 * 1024)
        if not body:
            return {}
        try:
            return json.loads(body.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise ValueError("Invalid JSON")

    def send_domains(self):
        try:
            groups = parse_domains(DOMAINS_FILE)
        except OSError as exc:
            self.send_json(500, {"error": html.escape(str(exc)), "path": DOMAINS_FILE})
            return

        self.send_json(200, {
            "path": DOMAINS_FILE,
            "groups": groups,
            "total": sum(len(group["domains"]) for group in groups),
        })

    def send_status(self):
        traffic = read_traffic_snapshot()
        if traffic is None:
            helper_payload = run_helper(["traffic"])
            traffic = helper_payload.get("traffic") if helper_payload.get("ok") is not False else zero_traffic()
        vpn_status = read_vpn_status_snapshot() or unknown_vpn_status("VPN status snapshot is not available yet")
        self.send_json(200, {
            "clients": read_wifi_clients(),
            "vpn_status": vpn_status,
            "traffic": traffic,
        })

    def send_vpn_configs(self):
        payload = run_helper(["list"])
        if payload.get("ok") is False:
            self.send_json(200, {
                "ok": True,
                "enabled": False,
                "active": None,
                "profiles": [],
                "error": management_disabled_message(),
            })
            return
        payload["enabled"] = True
        self.send_json(200, payload)

    def upload_vpn_configs(self):
        check = run_helper(["list"])
        if check.get("ok") is False:
            self.send_json(400, {"ok": False, "error": management_disabled_message()})
            return

        try:
            body = self.read_body(8 * 1024 * 1024)
            files = parse_multipart_files(self.headers, body)
        except ValueError as exc:
            self.send_json(400, {"ok": False, "error": str(exc)})
            return

        if not files:
            self.send_json(400, {"ok": False, "error": "No config files uploaded"})
            return

        imported = []
        errors = []
        for filename, payload in files:
            result = run_helper(["import", "-", filename], input_data=payload)
            if result.get("ok") is False:
                errors.append({"file": filename, "error": result.get("error", "Import failed")})
            else:
                imported.append(result.get("profile"))

        status = 200 if imported else 400
        error = None
        if errors:
            error = "; ".join("%s: %s" % (item["file"], item["error"]) for item in errors)
        self.send_json(status, {
            "ok": bool(imported),
            "imported": imported,
            "errors": errors,
            "error": error,
        })

    def select_vpn_config(self):
        check = run_helper(["list"])
        if check.get("ok") is False:
            self.send_json(400, {"ok": False, "error": management_disabled_message()})
            return

        try:
            payload = self.read_json_payload()
        except ValueError as exc:
            self.send_json(400, {"ok": False, "error": str(exc)})
            return
        name = str(payload.get("name", ""))
        result = run_helper(["select", name])
        status = 200 if result.get("ok") is not False else 400
        self.send_json(status, result)

    def delete_vpn_config(self):
        check = run_helper(["list"])
        if check.get("ok") is False:
            self.send_json(400, {"ok": False, "error": management_disabled_message()})
            return

        try:
            payload = self.read_json_payload()
        except ValueError as exc:
            self.send_json(400, {"ok": False, "error": str(exc)})
            return
        name = str(payload.get("name", ""))
        result = run_helper(["delete", name])
        status = 200 if result.get("ok") is not False else 400
        self.send_json(status, result)


def main():
    server = ThreadingHTTPServer((BIND, PORT), AdminHandler)
    print("VPN admin listening on http://%s:%s/admin" % (BIND, PORT), flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
