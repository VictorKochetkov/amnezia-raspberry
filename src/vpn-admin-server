      color: var(--danger);
      background: var(--error-bg);
    }

    @media (prefers-color-scheme: light) {
      :root {
        color-scheme: light;
        --bg: #edf3f8;
        --bg-top: #f8fbfd;
        --bg-bottom: #f4f8fb;
        --bg-glow: rgba(20, 184, 196, 0.14);
        --panel: rgba(255, 255, 255, 0.96);
        --panel-solid: #ffffff;
        --panel-border: rgba(74, 91, 111, 0.16);
        --panel-border-strong: rgba(74, 91, 111, 0.22);
        --text: #111827;
        --muted: #657487;
        --muted-strong: #4b5b6c;
        --control-bg: #f7fafc;
        --accent-soft: rgba(20, 184, 196, 0.12);
        --row: rgba(244, 247, 250, 0.82);
        --row-hover: #edf5f7;
        --surface-subtle: #f7fafc;
        --surface-icon: #eaf1f5;
        --divider-soft: rgba(74, 91, 111, 0.1);
        --traffic-bg: #ffffff;
        --donut-track: #94a3b8;
        --sparkline-grid: rgba(74, 91, 111, 0.13);
        --count-text: #087980;
        --success-soft: rgba(22, 163, 110, 0.12);
        --success-text: #137a55;
        --warning-soft: rgba(202, 138, 4, 0.14);
        --warning-text: #946200;
        --header-bg: rgba(255, 255, 255, 0.9);
        --header-control-bg: #f7fafc;
        --header-border: rgba(74, 91, 111, 0.16);
        --header-text: #111827;
        --header-muted: #657487;
        --status-text: #26374a;
        --status-border: rgba(74, 91, 111, 0.22);
        --dot-neutral: #94a3b8;
        --ready: #18a66f;
        --error: #e34862;
        --shadow: 0 16px 48px rgba(15, 23, 42, 0.1);
      }
    }

    @media (max-width: 720px) {
      .shell {
        width: min(100% - 20px, 1120px);
      }

      .topbar,
      .toolbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .topbar {
        padding: 18px 0 12px;
      }

      h1 {
        font-size: 26px;
      }

      h2 {
        font-size: 28px;
      }

      nav {
        overflow-x: auto;
      }

      .meta {
        text-align: left;
      }

      .header-metrics {
        align-items: flex-start;
        flex-wrap: wrap;
        justify-content: flex-start;
      }

      .summary {
        grid-template-columns: 1fr 1fr;
      }

      .domain-panel {
        grid-template-columns: 1fr;
      }

      .summary,
      .system-panel,
      .groups {
        grid-column: auto;
        grid-row: auto;
      }

      .system-panel {
        grid-template-columns: 1fr;
      }

      .upload-panel,
      .config-row {
        align-items: stretch;
        grid-template-columns: 1fr;
        flex-direction: column;
      }

      .config-actions {
        justify-content: flex-start;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="shell">
      <div class="topbar">
        <div class="brand">
          <div class="logo" aria-hidden="true">A</div>
          <h1>VPN Admin</h1>
        </div>
        <div class="header-metrics">
          <button class="header-button" id="system-reboot" type="button">Reboot</button>
          <div class="status" id="status"><span class="dot" id="status-dot"></span><span id="status-text">Loading</span></div>
        </div>
      </div>
      <nav aria-label="Admin sections">
        <button class="tab active" type="button" data-tab="domains">Domains</button>
        <button class="tab" type="button" data-tab="internet">Internet</button>
        <button class="tab" type="button" data-tab="vpn">VPN</button>
      </nav>
    </div>
  </header>

  <main>
    <div class="shell">
      <section class="view" id="domains-view">
        <div class="toolbar">
          <div>
            <h2 id="domains-heading">Split VPN Domains</h2>
            <div class="meta">Traffic rules grouped by destination</div>
          </div>
          <div class="meta"><span id="file-meta"></span><span id="wifi-ap-meta"></span></div>
        </div>

        <section class="domain-panel" aria-labelledby="domains-heading">
          <div class="summary">
            <div class="metric"><span>Domains</span><strong id="domains-total">0</strong></div>
            <div class="metric"><span>Clients</span><strong id="clients-total">0</strong></div>
          </div>
          <section class="system-panel" aria-label="System health">
            <article class="system-card">
              <div class="system-card-head">
                <span>Traffic</span>
                <strong class="traffic-total" id="traffic-total">0 B</strong>
              </div>
              <div class="traffic-card-body">
                <svg class="donut" viewBox="0 0 120 120" role="img" aria-label="VPN and direct traffic split">
                  <circle class="donut-bg" cx="60" cy="60" r="46"></circle>
                  <circle class="donut-direct" id="traffic-direct-arc" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="0 100"></circle>
                  <circle class="donut-vpn" id="traffic-vpn-arc" cx="60" cy="60" r="46" pathLength="100" stroke-dasharray="0 100"></circle>
                </svg>
                <div class="traffic-legend">
                  <div class="legend-row">
                    <span class="swatch"></span>
                    <span><span class="legend-name">VPN</span> <span id="traffic-vpn-percent">0%</span></span>
                    <strong id="traffic-vpn-bytes">0 B</strong>
                  </div>
                  <div class="legend-row">
                    <span class="swatch direct"></span>
                    <span><span class="legend-name">Direct</span> <span id="traffic-direct-percent">0%</span></span>
                    <strong id="traffic-direct-bytes">0 B</strong>
                  </div>
                </div>
              </div>
            </article>
            <article class="system-card">
              <div class="system-card-head">
                <span>CPU</span>
                <strong id="cpu-load">-</strong>
              </div>
              <svg class="sparkline" viewBox="0 0 120 46" preserveAspectRatio="none" aria-hidden="true">
                <path class="sparkline-bg" d="M0 23H120"></path>
                <polyline class="sparkline-line" id="cpu-line" points=""></polyline>
              </svg>
            </article>
            <article class="system-card">
              <div class="system-card-head">
                <span>Temperature</span>
                <strong id="cpu-temp">-</strong>
              </div>
              <svg class="sparkline" viewBox="0 0 120 46" preserveAspectRatio="none" aria-hidden="true">
                <path class="sparkline-bg" d="M0 23H120"></path>
                <polyline class="sparkline-line temp" id="temp-line" points=""></polyline>
              </svg>
            </article>
            <article class="system-card">
              <div class="system-card-head">
                <span>Power</span>
                <strong id="power-status">-</strong>
              </div>
              <svg class="sparkline" viewBox="0 0 120 46" preserveAspectRatio="none" aria-hidden="true">
                <path class="sparkline-bg" d="M0 23H120"></path>
                <polyline class="sparkline-line power" id="power-line" points=""></polyline>
              </svg>
              <div class="power-line" id="power-detail">No power data</div>
            </article>
          </section>
          <div class="groups" id="groups"></div>
        </section>
      </section>

      <section class="view hidden" id="internet-view">
        <div class="toolbar">
          <div>
            <h2 id="internet-heading">Internet Source</h2>
            <div class="meta">Choose the upstream connection used by direct and VPN traffic</div>
          </div>
          <div class="meta" id="internet-meta"></div>
        </div>

        <section class="config-list" id="source-list" aria-labelledby="internet-heading">
          <div class="empty">Loading internet sources.</div>
        </section>

        <section class="wifi-panel" aria-labelledby="wifi-upstream-heading">
          <div class="wifi-panel-head">
            <div>
              <h3 id="wifi-upstream-heading">Wi-Fi upstream</h3>
              <div class="meta" id="wifi-scan-meta">Scan nearby networks on the free adapter</div>
            </div>
            <button class="button compact primary" id="wifi-scan" type="button">Scan</button>
          </div>
          <div class="wifi-list" id="wifi-list">
            <div class="empty">No scan yet.</div>
          </div>
        </section>
      </section>

      <section class="view hidden" id="vpn-view">
        <div class="toolbar">
          <div>
            <h2 id="vpn-heading">VPN Configs</h2>
            <div class="meta">Upload, select, and remove AmneziaWG profiles</div>
          </div>
          <div class="meta">
            <button class="button compact" id="vpn-reconnect" type="button">Reconnect VPN</button>
            <span id="vpn-meta"></span>
          </div>
        </div>

        <form class="upload-panel" id="upload-form">
          <input class="file-input" id="config-files" name="configs" type="file" accept=".conf,.awg,.txt" multiple>
          <button class="button primary hidden" id="upload-button" type="submit">Upload</button>
        </form>

        <section class="config-list" id="config-list" aria-labelledby="vpn-heading">
          <div class="empty">Loading VPN configs.</div>
        </section>

        <section class="vpn-history" aria-labelledby="vpn-history-heading">
          <div class="history-head">
            <h3 id="vpn-history-heading">VPN History</h3>
            <div class="meta">Last 6 hours</div>
          </div>
          <div class="history-list" id="vpn-history-list">
            <div class="empty">Waiting for VPN status events.</div>
          </div>
        </section>
      </section>
    </div>
  </main>

  <script>
    const statusDot = document.getElementById("status-dot");
    const statusText = document.getElementById("status-text");
    const cpuLoad = document.getElementById("cpu-load");
    const cpuTemp = document.getElementById("cpu-temp");
    const powerStatus = document.getElementById("power-status");
    const cpuLine = document.getElementById("cpu-line");
    const tempLine = document.getElementById("temp-line");
    const powerLine = document.getElementById("power-line");
    const powerDetail = document.getElementById("power-detail");
    const fileMeta = document.getElementById("file-meta");
    const groupsNode = document.getElementById("groups");
    const domainsTotal = document.getElementById("domains-total");
    const clientsTotal = document.getElementById("clients-total");
    const trafficTotal = document.getElementById("traffic-total");
    const trafficVpnBytes = document.getElementById("traffic-vpn-bytes");
    const trafficDirectBytes = document.getElementById("traffic-direct-bytes");
    const trafficVpnPercent = document.getElementById("traffic-vpn-percent");
    const trafficDirectPercent = document.getElementById("traffic-direct-percent");
    const trafficVpnArc = document.getElementById("traffic-vpn-arc");
    const trafficDirectArc = document.getElementById("traffic-direct-arc");
    const wifiApMeta = document.getElementById("wifi-ap-meta");
    const tabs = Array.from(document.querySelectorAll("[data-tab]"));
    const systemReboot = document.getElementById("system-reboot");
    const views = {
      domains: document.getElementById("domains-view"),
      internet: document.getElementById("internet-view"),
      vpn: document.getElementById("vpn-view")
    };
    const internetMeta = document.getElementById("internet-meta");
    const sourceList = document.getElementById("source-list");
    const wifiScan = document.getElementById("wifi-scan");
    const wifiScanMeta = document.getElementById("wifi-scan-meta");
    const wifiList = document.getElementById("wifi-list");
    const vpnMeta = document.getElementById("vpn-meta");
    const configList = document.getElementById("config-list");
    const vpnHistoryList = document.getElementById("vpn-history-list");
    const uploadForm = document.getElementById("upload-form");
    const configFiles = document.getElementById("config-files");
    const uploadButton = document.getElementById("upload-button");
    const vpnReconnect = document.getElementById("vpn-reconnect");
    const systemHistory = { cpu: [], temp: [], power: [] };
    const systemHistoryLimit = 240;

    function setStatus(kind, text, title = "") {
      statusDot.className = "dot " + kind;
      statusText.textContent = text;
      statusText.title = title;
    }

    function render(data) {
      domainsTotal.textContent = data.total;
      fileMeta.textContent = data.path;

      if (!data.groups.length) {
        groupsNode.innerHTML = '<div class="empty">No domains found.</div>';
        return;
      }

      groupsNode.innerHTML = data.groups.map((group) => {
        const domains = group.domains.map((domain) => {
          return `<div class="domain">${escapeHtml(domain)}</div>`;
        }).join("");

        return `<details class="group">
          <summary class="group-head">
            <span class="group-main">
              <span class="chevron" aria-hidden="true"></span>
              <span class="group-title">${escapeHtml(group.name)}</span>
            </span>
            <span class="count">${group.domains.length}</span>
          </summary>
          <div class="domain-list">${domains}</div>
        </details>`;
      }).join("");
    }

    function renderStatus(data) {
      clientsTotal.textContent = data.clients.count;
      clientsTotal.title = data.clients.interface;
      renderVpnConnection(data.vpn_status);
      renderVpnHistory(data.vpn_status?.history);
      renderSystemHealth(data.system);
      renderTraffic(data.traffic);
      renderWifiAp(data.wifi_ap);
    }

    function renderSystemHealth(system) {
      const cpu = system?.cpu?.percent;
      const temp = system?.temperature?.celsius;
      const power = system?.power;
      if (Array.isArray(system?.history?.cpu)) {
        systemHistory.cpu = system.history.cpu.map((item) => item.percent).filter(Number.isFinite);
      } else if (Number.isFinite(cpu)) {
        pushHistory(systemHistory.cpu, cpu);
      }
      if (Array.isArray(system?.history?.temperature)) {
        systemHistory.temp = system.history.temperature.map((item) => item.celsius).filter(Number.isFinite);
      } else if (Number.isFinite(temp)) {
        pushHistory(systemHistory.temp, temp);
      }
      if (Array.isArray(system?.history?.power)) {
        systemHistory.power = system.history.power.map((item) => item.bad ? 1 : 0);
      } else if (power?.available) {
        pushHistory(systemHistory.power, power.throttled ? 1 : 0);
      }
      cpuLoad.textContent = Number.isFinite(cpu) ? `${Math.round(cpu)}%` : "-";
      cpuTemp.textContent = Number.isFinite(temp) ? `${Math.round(temp)}°C` : "-";
      cpuTemp.title = system?.temperature?.source || "";
      renderSparkline(cpuLine, systemHistory.cpu, 0, 100);
      renderSparkline(tempLine, systemHistory.temp);
      renderSparkline(powerLine, systemHistory.power, 0, 1);
      if (power?.available) {
        const badSamples = systemHistory.power.filter(Boolean).length;
        powerStatus.textContent = power.throttled ? "BAD" : power.was_throttled ? "EVENT" : "OK";
        powerStatus.title = [power.raw, ...(power.flags || [])].filter(Boolean).join(" · ");
        powerStatus.style.color = power.throttled ? "#fb7185" : power.was_throttled ? "#fbbf24" : "";
        powerDetail.textContent = badSamples ? `${badSamples} drop${badSamples === 1 ? "" : "s"} in window` : "No drops in window";
        powerDetail.title = powerStatus.title;
      } else {
        powerStatus.textContent = "Power -";
        powerStatus.title = power?.error || "";
        powerStatus.style.color = "";
        powerDetail.textContent = power?.error || "No power data";
        powerDetail.title = power?.error || "";
      }
    }

    function pushHistory(history, value) {
      history.push(value);
      if (history.length > systemHistoryLimit) history.shift();
    }

    function renderSparkline(node, values, fixedMin = null, fixedMax = null) {
      if (!node || values.length < 2) {
        if (node) node.setAttribute("points", "");
        return;
      }
      let min = fixedMin ?? Math.min(...values);
      let max = fixedMax ?? Math.max(...values);
      if (min === max) {
        min -= 1;
        max += 1;
      }
      const width = 120;
      const height = 46;
      const points = values.map((value, index) => {
        const x = values.length === 1 ? width : (index / (values.length - 1)) * width;
        const y = height - ((value - min) / (max - min)) * height;
        return `${x.toFixed(1)},${Math.max(0, Math.min(height, y)).toFixed(1)}`;
      }).join(" ");
      node.setAttribute("points", points);
    }

    function renderVpnConnection(status) {
      if (!status) {
        setStatus("error", "VPN unknown");
        return;
      }

      const kind = {
        connected: "ready",
        connecting: "connecting",
        disconnected: "disconnected",
        error: "error"
      }[status.state] || "error";

      const details = [
        status.service?.name,
        status.service?.active ? `service: ${status.service.active}` : "",
        status.interface?.exists === false ? `${status.interface.name} missing` : "",
        status.probe?.ok === true ? "probe: ok" : "",
        status.probe?.ok === false ? `probe: failed${status.probe.error ? ` (${status.probe.error})` : ""}` : "",
        status.probe?.ip ? `exit ip: ${status.probe.ip}` : "",
        status.latest_handshake ? `handshake: ${status.latest_handshake}` : "",
        status.endpoint ? `endpoint: ${status.endpoint}` : "",
        status.error || ""
      ].filter(Boolean).join(" · ");

      setStatus(kind, status.label || "VPN unknown", details);
    }

    function renderTraffic(traffic) {
      if (!traffic) return;
      const vpn = traffic.vpn?.bytes || 0;
      const direct = traffic.direct?.bytes || 0;
      const total = vpn + direct;
      const vpnPercent = total ? Math.round((vpn / total) * 100) : 0;
      const directPercent = total ? 100 - vpnPercent : 0;

      trafficTotal.textContent = formatBytes(total);
      trafficVpnBytes.textContent = formatBytes(vpn);
      trafficDirectBytes.textContent = formatBytes(direct);
      trafficVpnPercent.textContent = `${vpnPercent}%`;
      trafficDirectPercent.textContent = `${directPercent}%`;
      trafficVpnArc.setAttribute("stroke-dasharray", `${vpnPercent} ${100 - vpnPercent}`);
      trafficDirectArc.setAttribute("stroke-dasharray", `${directPercent} ${100 - directPercent}`);
      trafficDirectArc.setAttribute("stroke-dashoffset", String(-vpnPercent));
    }

    function renderWifiAp(wifiAp) {
      const current = wifiAp?.current || {};
      const selected = wifiAp?.selected || {};
      const channel = current.channel || selected.channel;
      const width = current.width || (selected.width_mhz ? `${selected.width_mhz} MHz` : "");
      const label = channel ? `AP ch ${channel}${width ? ` · ${width}` : ""}` : "AP -";
      wifiApMeta.textContent = fileMeta.textContent ? ` · ${label}` : label;
      const details = [
        current.ssid || "",
        current.interface || "",
        current.channel_text || current.error || ""
      ];
      if (selected.channel) {
        details.push([
          "selected",
          selected.mode === "auto" ? "auto" : "manual",
          selected.band === "a" ? "5 GHz" : selected.band,
          `${selected.width_mhz || "?"} MHz`,
          selected.score === null || selected.score === undefined ? "" : `score ${Math.round(selected.score)}`,
          selected.scan_ifname ? `scan ${selected.scan_ifname}` : "",
          selected.selected_at ? formatEventTime(selected.selected_at) : ""
        ].filter(Boolean).join(" · "));
      }
      wifiApMeta.title = details.filter(Boolean).join(" · ");
    }

    function renderVpnHistory(events) {
      if (!Array.isArray(events) || !events.length) {
        vpnHistoryList.innerHTML = '<div class="empty">No VPN status events yet.</div>';
        return;
      }

      vpnHistoryList.innerHTML = events.slice().reverse().map((event) => {
        const state = event.state || "error";
        const details = [
          event.service_active ? `service: ${event.service_active}` : "",
          event.interface_exists === false ? `${event.interface || "awg0"} missing` : "",
          event.probe_ok === true ? "probe: ok" : "",
          event.probe_ok === false ? `probe: failed${event.probe_error ? ` (${event.probe_error})` : ""}` : "",
          event.probe_ip ? `exit ip: ${event.probe_ip}` : "",
          event.latest_handshake ? `handshake: ${event.latest_handshake}` : "",
          event.endpoint ? `endpoint: ${event.endpoint}` : "",
          event.error || ""
        ].filter(Boolean).join(" · ");
        return `<article class="history-row">
          <time class="history-time" datetime="${new Date((event.ts || 0) * 1000).toISOString()}">${escapeHtml(formatEventTime(event.ts))}</time>
          <div class="history-main">
            <div class="history-title"><span class="history-dot ${escapeHtml(state)}"></span>${escapeHtml(event.label || state)}</div>
            <div class="history-detail">${escapeHtml(details || "Status changed")}</div>
          </div>
        </article>`;
      }).join("");
    }

    function formatBytes(bytes) {
      const units = ["B", "KB", "MB", "GB", "TB"];
      let value = Number(bytes) || 0;
      let index = 0;
      while (value >= 1024 && index < units.length - 1) {
        value /= 1024;
        index += 1;
      }
      const precision = value >= 10 || index === 0 ? 0 : 1;
      return `${value.toFixed(precision)} ${units[index]}`;
    }

    function renderVpn(data) {
      if (data.enabled === false) {
        vpnMeta.textContent = "VPN management disabled";
        configList.innerHTML = `<div class="empty">${escapeHtml(data.error || "VPN config management is not enabled.")}</div>`;
        return;
      }

      vpnMeta.textContent = data.active ? `Active: ${data.active}` : "No active saved profile";

      if (!data.profiles.length) {
        configList.innerHTML = '<div class="empty">No VPN configs uploaded.</div>';
        return;
      }

      configList.innerHTML = data.profiles.map((profile) => {
        const active = profile.active ? '<span class="active-pill">active</span>' : '';
        const date = new Date(profile.mtime * 1000).toLocaleString();
        const size = Math.max(1, Math.round(profile.size / 1024));
        return `<article class="config-row">
          <div>
            <h3 class="config-name">${escapeHtml(profile.name)} ${active}</h3>
            <div class="config-sub">${size} KB · ${escapeHtml(date)}</div>
          </div>
          <div class="config-actions">
            <button class="button primary" type="button" data-action="select" data-name="${escapeHtml(profile.name)}" ${profile.active ? "disabled" : ""}>Select</button>
            <button class="button danger" type="button" data-action="delete" data-name="${escapeHtml(profile.name)}" ${profile.active ? "disabled" : ""}>Delete</button>
          </div>
        </article>`;
      }).join("");
    }

    function renderSources(data) {
      const activeIface = data.active?.interface || "";
      const mode = data.mode || data.active?.mode || "auto";
      const requestedIface = data.active?.requested_interface || "";
      internetMeta.textContent = activeIface
        ? `${mode === "auto" ? "Auto" : "Manual"}: ${activeIface}${requestedIface && requestedIface !== activeIface ? ` · requested: ${requestedIface}` : ""}${data.default_route ? ` · default: ${data.default_route}` : ""}`
        : "No active source";

      if (!data.sources?.length) {
        sourceList.innerHTML = '<div class="empty">No internet sources found.</div>';
        return;
      }

      const autoRow = `<article class="config-row">
          <div>
            <h3 class="config-name">Auto ${mode === "auto" ? '<span class="active-pill">active</span>' : ''}</h3>
            <div class="config-sub">Choose a live source automatically and fallback when it disconnects</div>
          </div>
          <div class="config-actions">
            <button class="button primary" type="button" data-source="auto" ${mode === "auto" ? "disabled" : ""}>Select</button>
          </div>
        </article>`;

      sourceList.innerHTML = autoRow + data.sources.map((source) => {
        const active = source.active ? '<span class="active-pill">active</span>' : '';
        const requested = source.requested && !source.active ? '<span class="active-pill warning">requested</span>' : '';
        const route = source.default_route ? '<span class="active-pill">default route</span>' : '';
        const disabled = source.active || source.state === "unavailable" || (source.kind === "wifi" && !source.connection) ? "disabled" : "";
        return `<article class="config-row">
          <div>
            <h3 class="config-name">${escapeHtml(source.name)} ${active} ${requested} ${route}</h3>
            <div class="config-sub">${escapeHtml(source.interface)} · ${escapeHtml(source.type || source.kind)} · ${escapeHtml(source.state || "unknown")}${source.connection ? ` · ${escapeHtml(source.connection)}` : ""}</div>
          </div>
          <div class="config-actions">
            <button class="button primary" type="button" data-source="${escapeHtml(source.interface)}" ${disabled}>Select</button>
          </div>
        </article>`;
      }).join("");
    }

    function renderWifiNetworks(data) {
      const interfaces = data.interfaces || [];
      wifiScanMeta.textContent = interfaces.length
