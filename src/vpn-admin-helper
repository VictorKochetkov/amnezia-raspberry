def nmcli_connect_source(source):
    iface = source["interface"]
    devices = {device["interface"]: device for device in nmcli_devices()}
    connection = devices.get(iface, {}).get("connection")
    if source["kind"] == "wifi" and not connection:
        fail("Use Wi-Fi scan to choose a network first")
    if not connection:
        connection = "USB-Modem-%s" % iface if source["kind"] == "usb-modem" else iface
        run_command(["nmcli", "connection", "delete", connection], check=False, timeout=10)
        run_command([
            "nmcli", "connection", "add",
            "type", "ethernet",
            "ifname", iface,
            "con-name", connection,
            "autoconnect", "yes",
            "ipv4.method", "auto",
            "ipv4.route-metric", "10",
            "ipv6.method", "disabled",
        ], check=False, timeout=20)
    run_command(["nmcli", "device", "connect", iface], check=False, timeout=30)
    if connection:
        run_command(["nmcli", "connection", "modify", connection, "connection.autoconnect", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.never-default", "no"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.route-metric", "10"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv6.never-default", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "up", connection], check=False, timeout=45)
    for other in list_sources_payload()["sources"]:
        other_connection = other.get("connection")
        if other["interface"] == iface or not other_connection:
            continue
        run_command(["nmcli", "connection", "modify", other_connection, "ipv4.route-metric", "700"], check=False, timeout=10)
        run_command(["nmcli", "device", "reapply", other["interface"]], check=False, timeout=10)


