    os.chmod(ACTIVE_CONFIG, 0o600)
    try:
        subprocess.run(["systemctl", "disable", "--now", VLESS_SERVICE], check=False, timeout=30)
        if os.path.exists(VLESS_ACTIVE_PROFILE):
            os.remove(VLESS_ACTIVE_PROFILE)
        subprocess.run(["systemctl", "enable", AWG_SERVICE], check=False, timeout=15)
        restart_awg()
    except subprocess.CalledProcessError as exc:
