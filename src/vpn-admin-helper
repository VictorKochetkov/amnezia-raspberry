def fail(message, status=1):
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    raise SystemExit(status)


def ok(payload=None):
    result = {"ok": True}
    if payload:
        result.update(payload)
    print(json.dumps(result, ensure_ascii=False))


def resolve_command(candidates):
    for candidate in candidates:
        if candidate.startswith("/") and os.path.exists(candidate):
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def run_command(args, check=True, timeout=30, input_text=None):
    return subprocess.run(
        args,
        check=check,
        input=input_text,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def read_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as file:
            return file.read()
    except OSError:
        return default


def atomic_write_text(path, text, mode=0o644):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o755, exist_ok=True)
    existing_mode = None
    try:
        existing_mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        pass

    descriptor, temporary_path = tempfile.mkstemp(prefix=".vpn-admin-", dir=directory, text=True)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary_path, existing_mode if existing_mode is not None else mode)
        os.replace(temporary_path, path)
    finally:
        if os.path.exists(temporary_path):
            os.unlink(temporary_path)


def fan_boot_config_path():
    candidates = [FAN_BOOT_CONFIG] if FAN_BOOT_CONFIG else [
        "/boot/firmware/config.txt",
        "/boot/config.txt",
    ]
    for path in candidates:
        if path and os.path.isfile(path):
            return path
    return None


def fan_config_block():
    lines = [
        FAN_CONFIG_BEGIN,
        "# Keep the fan enabled and let the kernel apply the temperature curve.",
        "dtparam=cooling_fan=on",
    ]
    for index, point in enumerate(FAN_CURVE):
        lines.extend([
            "dtparam=fan_temp%d=%d" % (index, point["temperature_c"] * 1000),
            "dtparam=fan_temp%d_hyst=%d" % (index, point["hysteresis_c"] * 1000),
            "dtparam=fan_temp%d_speed=%d" % (index, point["speed"]),
        ])
    lines.append(FAN_CONFIG_END)
    return "\n".join(lines)


def update_fan_boot_config():
    path = fan_boot_config_path()
    if not path:
        fail("Raspberry Pi boot config was not found")

    current = read_text(path)
    pattern = re.compile(
        r"^" + re.escape(FAN_CONFIG_BEGIN) + r"\n.*?^" + re.escape(FAN_CONFIG_END) + r"(?:\n|$)",
        re.MULTILINE | re.DOTALL,
    )
    current = pattern.sub("", current).rstrip()
    updated = (current + "\n\n" if current else "") + fan_config_block() + "\n"
    if updated != read_text(path):
        atomic_write_text(path, updated)
    return path


def read_int(path):
    try:
        return int(read_text(path).strip())
    except ValueError:
        return None


def find_pwm_fan():
    thermal_class = os.environ.get("VPN_ADMIN_THERMAL_CLASS", "/sys/class/thermal")
    try:
        entries = sorted(os.listdir(thermal_class))
    except OSError:
        return None
    for name in entries:
        if not name.startswith("cooling_device"):
            continue
        path = os.path.join(thermal_class, name)
        if read_text(os.path.join(path, "type")).strip() == "pwm-fan":
            return path
    return None


def find_pwm_fan_hwmon():
    hwmon_class = os.environ.get("VPN_ADMIN_HWMON_CLASS", "/sys/class/hwmon")
    try:
        entries = sorted(os.listdir(hwmon_class))
    except OSError:
        return None
    for name in entries:
        path = os.path.join(hwmon_class, name)
        if read_text(os.path.join(path, "name")).strip() == "pwmfan":
            return path
    return None


def read_fan_hwmon_status():
    path = find_pwm_fan_hwmon()
    if not path:
        return None
    return {
        "path": path,
        "enable_mode": read_int(os.path.join(path, "pwm1_enable")),
        "pwm": read_int(os.path.join(path, "pwm1")),
    }


def read_active_trip_temperatures():
    thermal_zone = os.environ.get("VPN_ADMIN_THERMAL_ZONE", "/sys/class/thermal/thermal_zone0")
    temperatures = []
    for index in range(16):
        trip_type = read_text(os.path.join(thermal_zone, "trip_point_%d_type" % index)).strip()
        if trip_type != "active":
            continue
        value = read_int(os.path.join(thermal_zone, "trip_point_%d_temp" % index))
        if value is not None:
            temperatures.append(value)
    return temperatures


def enable_runtime_fan():
    hwmon = read_fan_hwmon_status()
    if not hwmon:
        return False

    try:
        with open(os.path.join(hwmon["path"], "pwm1_enable"), "w", encoding="utf-8") as file:
            file.write("1\n")
        device = find_pwm_fan()
        temperature = read_int(os.environ.get("VPN_ADMIN_TEMP_FILE", "/sys/class/thermal/thermal_zone0/temp"))
        trips = read_active_trip_temperatures()
        if device and temperature is not None and trips:
            target_state = min(sum(temperature >= trip for trip in trips), len(FAN_CURVE))
            with open(os.path.join(device, "cur_state"), "w", encoding="utf-8") as file:
                file.write("%d\n" % target_state)
    except OSError as exc:
        fail("Failed to enable the running fan: " + str(exc))
    return True


def fan_status_payload():
    device = find_pwm_fan()
    hwmon = read_fan_hwmon_status()
    applied_enabled = bool(hwmon and hwmon.get("enable_mode") not in (None, 0))
    current_state = read_int(os.path.join(device, "cur_state")) if device else 0
    max_state = read_int(os.path.join(device, "max_state")) if device else 0
    current_state = current_state if current_state is not None else 0
    max_state = max_state if max_state is not None else 0

    if not applied_enabled:
        speed_percent = 0
    elif hwmon and hwmon.get("pwm") is not None:
        speed_percent = round(hwmon["pwm"] * 100 / 255)
    elif current_state <= 0:
        speed_percent = 0
    elif current_state <= len(FAN_CURVE):
        speed_percent = FAN_CURVE[current_state - 1]["speed_percent"]
    elif max_state:
        speed_percent = round(current_state * 100 / max_state)
    else:
        speed_percent = None

    restart_required = not applied_enabled
    active_temperatures = read_active_trip_temperatures()
    desired_temperatures = [point["temperature_c"] * 1000 for point in FAN_CURVE]
    if applied_enabled and active_temperatures:
        restart_required = restart_required or active_temperatures[:len(desired_temperatures)] != desired_temperatures

    return {
        "enabled": applied_enabled,
        "available": bool(device or hwmon),
        "applied": applied_enabled,
        "restart_required": restart_required,
        "speed_percent": speed_percent,
        "current_state": current_state,
        "max_state": max_state,
        "curve": list(FAN_CURVE),
    }


def read_fan_status():
    ok({"fan": fan_status_payload()})


def apply_fan_state():
    boot_config = update_fan_boot_config()
    runtime_applied = enable_runtime_fan()
    ok({"enabled": True, "runtime_applied": runtime_applied, "boot_config": boot_config})


def current_default_iface():
    result = run_command(["ip", "route", "show", "default"], check=False, timeout=5)
    for line in result.stdout.splitlines():
        parts = line.split()
        if "dev" in parts:
            index = parts.index("dev")
            if index + 1 < len(parts):
                return parts[index + 1]
    return None


def load_source_state():
    try:
        with open(SOURCE_STATE_FILE, "r", encoding="utf-8") as file:
            state = json.load(file)
        if isinstance(state, dict):
            if state.get("mode") not in ("auto", "manual"):
                state["mode"] = "manual" if state.get("interface") else "auto"
            return state
    except (OSError, json.JSONDecodeError):
        pass
    return {
        "mode": "auto",
        "interface": current_default_iface() or DEFAULT_UPSTREAM_IFACE,
        "requested_interface": "",
        "kind": "ethernet",
        "name": "Auto",
    }


def save_source_state(source, mode="manual", requested_interface=None):
    os.makedirs(os.path.dirname(SOURCE_STATE_FILE), mode=0o755, exist_ok=True)
    payload = {
        "mode": mode,
        "interface": source["interface"],
        "requested_interface": requested_interface if mode == "manual" else "",
        "kind": source["kind"],
        "name": source["name"],
        "updated_at": int(time.time()),
    }
    with open(SOURCE_STATE_FILE, "w", encoding="utf-8") as file:
        json.dump(payload, file)
        file.write("\n")
    return payload


def nmcli_devices():
    result = run_command(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"],
        check=False,
        timeout=10,
    )
    devices = []
    for line in result.stdout.splitlines():
        parts = line.split(":", 3)
        if len(parts) != 4:
            continue
        device, dev_type, state, connection = parts
        devices.append({
            "interface": device,
            "type": dev_type,
            "state": state,
            "connection": "" if connection == "--" else connection,
        })
    return devices


def ap_wifi_ifaces():
    ifaces = set()
    for device in nmcli_devices():
        if device["connection"] == "RaspberryWiFi-AP":
            ifaces.add(device["interface"])
    if not ifaces and WIFI_IFACE:
        ifaces.add(WIFI_IFACE)
    return ifaces


def wifi_source_ifaces():
    excluded = ap_wifi_ifaces() | {AWG_IFACE, "lo"}
    return [
        device
        for device in nmcli_devices()
        if device["type"] == "wifi"
        and device["interface"] not in excluded
        and not device["interface"].startswith("p2p-dev-")
    ]


def ap_ssids():
    ssids = set()
    for device in nmcli_devices():
        if device["connection"] == "RaspberryWiFi-AP":
            ssid = connection_value("802-11-wireless.ssid", device["connection"])
            if ssid:
                ssids.add(ssid)
    return ssids


def source_kind(device):
    iface = device["interface"]
    dev_type = device["type"]
    if iface in ap_wifi_ifaces() or iface.startswith("p2p-dev-") or iface == AWG_IFACE or iface == "lo":
        return None
    if iface == "eth0":
        return "ethernet"
    if dev_type == "wifi":
        return "wifi"
    if dev_type in {"gsm", "cdma"}:
        return "usb-modem"
    if dev_type == "ethernet" and (iface != "eth0" or iface.startswith(USB_MODEM_PREFIXES)):
        return "usb-modem"
    if iface.startswith(USB_MODEM_PREFIXES):
        return "usb-modem"
    return None


def list_sources_payload():
    state = load_source_state()
    default_iface = current_default_iface()
    active_iface = state.get("interface")
    requested_iface = state.get("requested_interface") or active_iface
    sources = []
    for device in nmcli_devices():
        kind = source_kind(device)
        if not kind:
            continue
        iface = device["interface"]
        sources.append({
            "interface": iface,
            "kind": kind,
            "name": source_name_for(kind, device.get("connection")),
            "state": device["state"],
            "connection": device["connection"],
            "active": iface == active_iface,
            "requested": state.get("mode") == "manual" and iface == requested_iface,
            "default_route": iface == default_iface,
        })
    if not any(source["interface"] == "eth0" for source in sources):
        sources.insert(0, {
            "interface": "eth0",
            "kind": "ethernet",
            "name": "Ethernet",
            "state": "unavailable",
            "connection": "",
            "active": active_iface == "eth0",
            "requested": state.get("mode") == "manual" and requested_iface == "eth0",
            "default_route": default_iface == "eth0",
        })
    return {
        "sources": sources,
        "active": state,
        "mode": state.get("mode", "auto"),
        "default_route": default_iface,
    }


def list_sources():
    ok(list_sources_payload())


def connection_value(setting, connection):
    if not connection:
        return ""
    result = run_command(["nmcli", "-g", setting, "connection", "show", connection], check=False, timeout=5)
    return result.stdout.strip().splitlines()[0] if result.stdout.strip() else ""


def source_name_for(kind, connection=None):
    if kind == "ethernet":
        return "Ethernet"
    if kind == "usb-modem":
        return "USB modem"
    if kind == "wifi":
        ssid = connection_value("802-11-wireless.ssid", connection)
        if ssid:
            return ssid
        if connection and connection.startswith(WIFI_SOURCE_PREFIX):
            return connection[len(WIFI_SOURCE_PREFIX):]
        return "Wi-Fi"
    return "Internet source"


def kind_for_iface(iface):
    for device in nmcli_devices():
        if device["interface"] == iface:
            return source_kind(device)
    if iface == "eth0":
        return "ethernet"
    return "usb-modem"


def connection_name_for_wifi(ssid):
    digest = hashlib.sha1(ssid.encode("utf-8")).hexdigest()[:10]
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", ssid).strip(".-")[:40] or "network"
    return "%s%s-%s" % (WIFI_SOURCE_PREFIX, safe, digest)


def nmcli_unescape(value):
    result = []
    escaped = False
    for char in value:
        if escaped:
            result.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        else:
            result.append(char)
    if escaped:
        result.append("\\")
    return "".join(result)


def parse_nmcli_line(line, expected_fields):
    fields = []
    current = []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":" and len(fields) < expected_fields - 1:
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def list_wifi_networks():
    networks = {}
    wifi_ifaces = wifi_source_ifaces()
    own_ap_ssids = ap_ssids()
    for device in wifi_ifaces:
        iface = device["interface"]
        run_command(["nmcli", "device", "wifi", "rescan", "ifname", iface], check=False, timeout=15)
        result = run_command(
            ["nmcli", "-t", "-f", "SSID,SECURITY,SIGNAL,CHAN,IN-USE", "device", "wifi", "list", "ifname", iface],
            check=False,
            timeout=20,
        )
        for line in result.stdout.splitlines():
            parts = parse_nmcli_line(line, 5)
            if len(parts) != 5:
                continue
            ssid, security, signal, channel, in_use = parts
            ssid = nmcli_unescape(ssid).strip()
            if not ssid or ssid in own_ap_ssids:
                continue
            try:
                signal_value = int(signal)
            except ValueError:
                signal_value = 0
            key = (iface, ssid)
            item = networks.get(key)
            if item and item["signal"] >= signal_value:
                continue
            networks[key] = {
                "interface": iface,
                "ssid": ssid,
                "security": nmcli_unescape(security).strip(),
                "signal": signal_value,
                "channel": channel,
                "in_use": in_use == "*",
            }
    ok({
        "interfaces": [device["interface"] for device in wifi_ifaces],
        "networks": sorted(networks.values(), key=lambda item: (-item["signal"], item["ssid"].lower())),
    })


def connect_wifi_source(iface, ssid, password):
    devices = {device["interface"]: device for device in wifi_source_ifaces()}
    if iface not in devices:
        fail("No available Wi-Fi interface for internet source")
    ssid = str(ssid or "").strip()
    if not ssid:
        fail("Wi-Fi SSID is required")
    if len(password or "") > 0 and len(password) < 8:
        fail("Wi-Fi password must be at least 8 characters")

    connection = connection_name_for_wifi(ssid)
    run_command(["nmcli", "connection", "delete", connection], check=False, timeout=10)
    args = [
        "nmcli", "connection", "add",
        "type", "wifi",
        "ifname", iface,
        "con-name", connection,
        "ssid", ssid,
        "autoconnect", "yes",
        "ipv4.method", "auto",
        "ipv4.route-metric", "10",
        "ipv6.method", "disabled",
    ]
    run_command(args, timeout=20)
    if password:
        run_command([
            "nmcli", "connection", "modify", connection,
            "wifi-sec.key-mgmt", "wpa-psk",
            "wifi-sec.psk", password,
        ], timeout=10)
    run_command(["nmcli", "connection", "up", connection], timeout=45)
    source = {
        "interface": iface,
        "kind": "wifi",
        "name": ssid,
    }
    state = save_source_state(source, mode="manual", requested_interface=iface)
    run_command(["systemctl", "start", "vpn-router-source-apply.service"], timeout=90)
    ok({**list_sources_payload(), "selected": state})


def nmcli_connect_source(source):
    iface = source["interface"]
    devices = {device["interface"]: device for device in nmcli_devices()}
    connection = devices.get(iface, {}).get("connection")
    if source["kind"] == "wifi" and not connection:
        fail("Use Wi-Fi scan to choose a network first")
    if not connection:
        connection = "USB-Modem-%s" % iface if source["kind"] == "usb-modem" else iface
        run_command(["nmcli", "connection", "delete", connection], check=False, timeout=10)
        run_command([
            "nmcli", "connection", "add",
            "type", "ethernet",
            "ifname", iface,
            "con-name", connection,
            "autoconnect", "yes",
            "ipv4.method", "auto",
            "ipv4.route-metric", "10",
            "ipv6.method", "disabled",
        ], check=False, timeout=20)
    run_command(["nmcli", "device", "connect", iface], check=False, timeout=30)
    if connection:
        run_command(["nmcli", "connection", "modify", connection, "connection.autoconnect", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.never-default", "no"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.route-metric", "10"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv6.never-default", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "up", connection], check=False, timeout=45)
    for other in list_sources_payload()["sources"]:
        other_connection = other.get("connection")
        if other["interface"] == iface or not other_connection:
            continue
        run_command(["nmcli", "connection", "modify", other_connection, "ipv4.route-metric", "700"], check=False, timeout=10)
        run_command(["nmcli", "device", "reapply", other["interface"]], check=False, timeout=10)


def render_nftables(upstream_iface):
    if not os.path.exists(NFT_TEMPLATE_FILE):
        fail("nftables template is missing; redeploy the admin package")
    with open(NFT_TEMPLATE_FILE, "r", encoding="utf-8") as file:
        rendered = file.read()
    rendered = rendered.replace("@WIFI_IFACE@", WIFI_IFACE).replace("@UPSTREAM_IFACE@", upstream_iface)
    tmp_path = os.path.join(os.path.dirname(SOURCE_STATE_FILE), "nftables.conf.tmp")
    with open(tmp_path, "w", encoding="utf-8") as file:
        file.write(rendered)
    run_command(["nft", "-c", "-f", tmp_path], timeout=10)
    with open(NFTABLES_FILE, "w", encoding="utf-8") as file:
        file.write(rendered)
    os.chmod(NFTABLES_FILE, 0o644)
    try:
        os.remove(tmp_path)
    except OSError:
        pass
    run_command(["nft", "delete", "table", "inet", NFT_TABLE], check=False, timeout=10)
    run_command(["nft", "delete", "table", "ip", "vpn_router_nat"], check=False, timeout=10)
    run_command(["nft", "-f", NFTABLES_FILE], timeout=10)


def select_source(interface):
    if interface == "auto":
        current_iface = current_default_iface() or DEFAULT_UPSTREAM_IFACE
        source = {
            "interface": current_iface,
            "kind": kind_for_iface(current_iface) or "usb-modem",
            "name": "Auto",
        }
        state = save_source_state(source, mode="auto")
        run_command(["systemctl", "start", "vpn-router-source-apply.service"], timeout=90)
        ok({**list_sources_payload(), "selected": state})
        return

    sources = list_sources_payload()["sources"]
    source = next((item for item in sources if item["interface"] == interface), None)
    if not source:
        fail("Unknown internet source")
    nmcli_connect_source(source)
    state = save_source_state(source, mode="manual", requested_interface=interface)
    run_command(["systemctl", "start", "vpn-router-source-apply.service"], timeout=90)
    ok({**list_sources_payload(), "selected": state})


def ensure_dirs():
    os.makedirs(PROFILES_DIR, mode=0o700, exist_ok=True)
    os.chmod(PROFILES_DIR, 0o700)
    if os.path.exists(ACTIVE_CONFIG) and not list(profile_paths()):
        target = unique_profile_name("current.conf")
        shutil.copy2(ACTIVE_CONFIG, os.path.join(PROFILES_DIR, target))
        os.chmod(os.path.join(PROFILES_DIR, target), 0o600)


def profile_paths():
    if not os.path.isdir(PROFILES_DIR):
        return
    for name in sorted(os.listdir(PROFILES_DIR)):
        path = os.path.join(PROFILES_DIR, name)
        if is_safe_name(name) and os.path.isfile(path):
            yield name, path


def is_safe_name(name):
    return (
        name
        and name == os.path.basename(name)
        and not name.startswith(".")
        and re.fullmatch(r"[A-Za-z0-9._-]+", name) is not None
    )


def sanitize_name(name):
    base = os.path.basename(name or "amnezia.conf").strip()
    base = re.sub(r"\s+", "-", base)
    base = re.sub(r"[^A-Za-z0-9._-]", "-", base)
    base = re.sub(r"-+", "-", base).strip(".-")
    if not base:
        base = "amnezia"
    if not base.lower().endswith(".conf"):
        base += ".conf"
    return base[:96]


def unique_profile_name(name):
    safe = sanitize_name(name)
    stem, ext = os.path.splitext(safe)
    candidate = safe
    index = 2
    while os.path.exists(os.path.join(PROFILES_DIR, candidate)):
        candidate = "%s-%s%s" % (stem, index, ext or ".conf")
        index += 1
    return candidate


def profile_path(name):
    if not is_safe_name(name):
        fail("Invalid profile name")
    path = os.path.join(PROFILES_DIR, name)
    if not os.path.isfile(path):
        fail("Profile not found")
    return path


def file_hash(path):
    if not os.path.exists(path):
        return None
    digest = hashlib.sha256()
    with open(path, "rb") as file:
        for chunk in iter(lambda: file.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_config_data(data):
    if not data:
        fail("Config is empty")
    if len(data) > MAX_CONFIG_SIZE:
        fail("Config is too large")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("Config must be UTF-8 text")
    return data, text


def read_config(path):
    if path == "-":
        return read_config_data(sys.stdin.buffer.read(MAX_CONFIG_SIZE + 1))
    size = os.path.getsize(path)
    if size <= 0:
        fail("Config is empty")
    if size > MAX_CONFIG_SIZE:
        fail("Config is too large")
    with open(path, "rb") as file:
        return read_config_data(file.read())


def split_key(line):
    if "=" not in line:
        return None
    key = line.split("=", 1)[0].strip()
    return key.lower() if key else None


def append_missing_interface_defaults(output, keys):
    for key, value in INTERFACE_DEFAULTS:
        if key.lower() not in keys:
            output.append("%s = %s" % (key, value))


def normalize_config_text(text, omit_dns=False):
    output = []
    section = None
    interface_keys = set()
    interface_defaults_added = False

    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if section == "interface" and not interface_defaults_added:
                append_missing_interface_defaults(output, interface_keys)
                interface_defaults_added = True
            section = stripped.strip("[]").strip().lower()
            output.append(line)
            continue

        key = split_key(line)
        if section == "interface" and key:
            if key in UNSUPPORTED_INTERFACE_KEYS or (omit_dns and key == "dns"):
                continue
            interface_keys.add(key)

        output.append(line)

    if section == "interface" and not interface_defaults_added:
        append_missing_interface_defaults(output, interface_keys)

    return ("\n".join(output).rstrip() + "\n").encode("utf-8")


def runtime_config_data(data):
    return normalize_config_text(data.decode("utf-8"), omit_dns=True)


def runtime_profile_hash(path):
    try:
        with open(path, "rb") as file:
            data = file.read(MAX_CONFIG_SIZE + 1)
        if not data or len(data) > MAX_CONFIG_SIZE:
            return None
        return hashlib.sha256(runtime_config_data(data)).hexdigest()
    except (OSError, UnicodeDecodeError):
        return None


def validate_config(path):
    data, text = read_config(path)
    lowered = text.lower()
    required = ("[interface]", "[peer]", "privatekey", "endpoint")
    missing = [item for item in required if item not in lowered]
    if missing:
        fail("Config does not look like an AmneziaWG profile: missing " + ", ".join(missing))
    return normalize_config_text(text)


def profile_meta(name, path, active_hash):
    stat = os.stat(path)
    return {
        "name": name,
        "active": runtime_profile_hash(path) == active_hash,
        "size": stat.st_size,
        "mtime": int(stat.st_mtime),
    }


def list_profiles():
    ensure_dirs()
    active_hash = file_hash(ACTIVE_CONFIG)
    profiles = [profile_meta(name, path, active_hash) for name, path in profile_paths()]
    active = next((profile["name"] for profile in profiles if profile["active"]), None)
    ok({"active": active, "profiles": profiles})


def import_profile(source_path, original_name):
    ensure_dirs()
    data = validate_config(source_path)
    name = unique_profile_name(original_name)
    target = os.path.join(PROFILES_DIR, name)
    with open(target, "wb") as file:
        file.write(data)
    os.chmod(target, 0o600)
    active_hash = file_hash(ACTIVE_CONFIG)
    ok({"profile": profile_meta(name, target, active_hash)})


def restart_vpn():
    resolvconf = resolve_command(["/sbin/resolvconf", "/usr/sbin/resolvconf", "resolvconf"])
    if resolvconf:
        subprocess.run([resolvconf, "-d", AWG_IFACE], check=False, timeout=10)
    subprocess.run(["systemctl", "restart", AWG_SERVICE], check=True, timeout=30)
    subprocess.run(["systemctl", "start", "vpn-split-update.service"], check=False, timeout=60)


def reconnect_vpn():
    try:
        restart_vpn()
    except subprocess.CalledProcessError as exc:
        fail("Failed to restart VPN service: " + str(exc))
    ok({"restarted": AWG_SERVICE})


def reboot_system():
    systemd_run = shutil.which("systemd-run")
    systemctl = shutil.which("systemctl") or "/bin/systemctl"
    try:
        if systemd_run:
            subprocess.run(
                [systemd_run, "--unit=vpn-admin-reboot", "--on-active=3", systemctl, "reboot"],
                check=True,
                timeout=10,
            )
        else:
            subprocess.Popen([systemctl, "reboot"])
    except (OSError, subprocess.CalledProcessError) as exc:
        fail("Failed to schedule reboot: " + str(exc))
    ok({"scheduled": True})


def select_profile(name):
    ensure_dirs()
    path = profile_path(name)
    data = validate_config(path)
    runtime_data = runtime_config_data(data)
    backup = ACTIVE_CONFIG + ".admin-backup-" + time.strftime("%Y%m%d%H%M%S")
    if os.path.exists(ACTIVE_CONFIG):
        shutil.copy2(ACTIVE_CONFIG, backup)
        os.chmod(backup, 0o600)
    with open(path, "wb") as file:
        file.write(data)
    os.chmod(path, 0o600)
    with open(ACTIVE_CONFIG, "wb") as file:
        file.write(runtime_data)
    os.chmod(ACTIVE_CONFIG, 0o600)
    try:
        restart_vpn()
    except subprocess.CalledProcessError as exc:
        if os.path.exists(backup):
            shutil.copy2(backup, ACTIVE_CONFIG)
            os.chmod(ACTIVE_CONFIG, 0o600)
            subprocess.run(["systemctl", "restart", AWG_SERVICE], check=False, timeout=30)
        fail("Failed to restart VPN service: " + str(exc))
    ok({"active": name})


def delete_profile(name):
    ensure_dirs()
    path = profile_path(name)
    active_hash = file_hash(ACTIVE_CONFIG)
    if runtime_profile_hash(path) == active_hash:
        fail("Cannot delete active profile")
    os.remove(path)
    ok({"deleted": name})


def run_text(command, timeout=5):
    try:
        return subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(command, 1, "", str(exc))


def service_state():
    active = run_text(["systemctl", "is-active", AWG_SERVICE], timeout=4)
    failed = run_text(["systemctl", "is-failed", AWG_SERVICE], timeout=4)
    return {
        "name": AWG_SERVICE,
        "active": active.stdout.strip() or "unknown",
        "failed": failed.stdout.strip() or "unknown",
    }


def interface_exists():
    result = run_text(["ip", "link", "show", AWG_IFACE], timeout=4)
    return result.returncode == 0


def parse_duration_seconds(value):
    value = value.strip().lower()
    if not value or value == "(none)":
        return None
    total = 0
    for amount, unit in re.findall(r"(\d+)\s+([a-z]+)", value):
        number = int(amount)
        if unit.startswith("second"):
            total += number
        elif unit.startswith("minute"):
            total += number * 60
        elif unit.startswith("hour"):
            total += number * 3600
        elif unit.startswith("day"):
            total += number * 86400
    return total if total else None


def parse_awg_show(output):
    status = {
        "endpoint": None,
        "latest_handshake": None,
        "latest_handshake_seconds": None,
        "transfer": None,
    }
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("endpoint:"):
            status["endpoint"] = line.split(":", 1)[1].strip()
        elif line.startswith("latest handshake:"):
            value = line.split(":", 1)[1].strip()
            status["latest_handshake"] = value
            status["latest_handshake_seconds"] = parse_duration_seconds(value)
        elif line.startswith("transfer:"):
            status["transfer"] = line.split(":", 1)[1].strip()
    return status


def read_vpn_status():
    service = service_state()
    has_interface = interface_exists()
    awg = resolve_command(("awg", "wg"))
    show = {}
    error = None

    if awg and has_interface:
        result = run_text([awg, "show", AWG_IFACE], timeout=5)
        if result.returncode == 0:
            show = parse_awg_show(result.stdout)
        else:
            error = (result.stderr or result.stdout or "Failed to read VPN interface").strip()
    elif not awg:
        error = "awg/wg command not found"

    handshake_seconds = show.get("latest_handshake_seconds")
    if service["failed"] == "failed" or service["active"] == "failed":
        state = "error"
        label = "VPN error"
    elif service["active"] in ("inactive", "deactivating"):
        state = "disconnected"
        label = "VPN disconnected"
    elif service["active"] == "activating":
        state = "connecting"
        label = "VPN connecting"
    elif service["active"] == "active" and has_interface and handshake_seconds is not None:
        if handshake_seconds <= STALE_HANDSHAKE_SECONDS:
            state = "connected"
            label = "VPN connected"
        else:
            state = "connecting"
            label = "VPN stale"
    elif service["active"] == "active" and has_interface:
        state = "connecting"
        label = "VPN connecting"
    else:
        state = "disconnected"
        label = "VPN disconnected"

    ok({
        "vpn_status": {
            "state": state,
            "label": label,
            "service": service,
            "interface": {"name": AWG_IFACE, "exists": has_interface},
            "endpoint": show.get("endpoint"),
            "latest_handshake": show.get("latest_handshake"),
            "latest_handshake_seconds": handshake_seconds,
            "transfer": show.get("transfer"),
            "stale_after_seconds": STALE_HANDSHAKE_SECONDS,
            "error": error,
        }
    })


def expr_match_value(expr, meta_key):
    match = expr.get("match")
    if not match:
        return None
    left = match.get("left")
    if not isinstance(left, dict):
        return None
    meta = left.get("meta")
    if not isinstance(meta, dict) or meta.get("key") != meta_key:
        return None
    return match.get("right")


def rule_interfaces(exprs):
    iif = None
    oif = None
    for expr in exprs:
        value = expr_match_value(expr, "iifname")
        if value is not None:
            iif = value
        value = expr_match_value(expr, "oifname")
        if value is not None:
            oif = value
    return iif, oif


def rule_counter(exprs):
    for expr in exprs:
        counter = expr.get("counter")
        if isinstance(counter, dict):
            return {
                "packets": int(counter.get("packets", 0)),
                "bytes": int(counter.get("bytes", 0)),
            }
    return {"packets": 0, "bytes": 0}


def read_traffic():
    upstream_iface = load_source_state().get("interface") or DEFAULT_UPSTREAM_IFACE
    result = subprocess.run(
        ["nft", "-j", "list", "chain", NFT_TABLE_FAMILY, NFT_TABLE, NFT_FORWARD_CHAIN],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or "Failed to read nft counters").strip())

    payload = json.loads(result.stdout)
    traffic = {
        "vpn": {"bytes": 0, "packets": 0},
        "direct": {"bytes": 0, "packets": 0},
    }

    for item in payload.get("nftables", []):
        rule = item.get("rule")
        if not rule:
            continue
        exprs = rule.get("expr", [])
        iif, oif = rule_interfaces(exprs)
        counter = rule_counter(exprs)

        if (iif, oif) in ((WIFI_IFACE, "awg0"), ("awg0", WIFI_IFACE)):
            bucket = traffic["vpn"]
        elif (iif, oif) in ((WIFI_IFACE, upstream_iface), (upstream_iface, WIFI_IFACE)):
            bucket = traffic["direct"]
        else:
            continue

        bucket["bytes"] += counter["bytes"]
        bucket["packets"] += counter["packets"]

    total = traffic["vpn"]["bytes"] + traffic["direct"]["bytes"]
    ok({"traffic": {**traffic, "total_bytes": total}})


def main():
    if len(sys.argv) < 2:
        fail("Missing action")

    action = sys.argv[1]
    if action == "list":
        list_profiles()
    elif action == "status":
        read_vpn_status()
    elif action == "traffic":
        read_traffic()
    elif action == "sources":
        list_sources()
    elif action == "source-select" and len(sys.argv) == 3:
        select_source(sys.argv[2])
    elif action == "wifi-scan":
        list_wifi_networks()
    elif action == "wifi-connect" and len(sys.argv) == 3:
        payload = json.load(sys.stdin)
        connect_wifi_source(sys.argv[2], payload.get("ssid"), payload.get("password", ""))
    elif action == "vpn-reconnect":
        reconnect_vpn()
    elif action == "fan-status":
        read_fan_status()
    elif action == "fan-apply":
        apply_fan_state()
    elif action == "reboot":
        reboot_system()
    elif action == "import" and len(sys.argv) == 4:
        import_profile(sys.argv[2], sys.argv[3])
    elif action == "select" and len(sys.argv) == 3:
        select_profile(sys.argv[2])
    elif action == "delete" and len(sys.argv) == 3:
        delete_profile(sys.argv[2])
    else:
        fail("Unsupported action")


if __name__ == "__main__":
    main()
