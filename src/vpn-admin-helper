def ensure_dirs():
    os.makedirs(PROFILES_DIR, mode=0o700, exist_ok=True)
    os.chmod(PROFILES_DIR, 0o700)
    if os.path.exists(ACTIVE_CONFIG) and not list(profile_paths()):
        target = unique_profile_name("current.conf")
        shutil.copy2(ACTIVE_CONFIG, os.path.join(PROFILES_DIR, target))
        os.chmod(os.path.join(PROFILES_DIR, target), 0o600)


def profile_paths():
    if not os.path.isdir(PROFILES_DIR):
        return
    for name in sorted(os.listdir(PROFILES_DIR)):
        path = os.path.join(PROFILES_DIR, name)
        if is_safe_name(name) and os.path.isfile(path):
            yield name, path


def is_safe_name(name):
    return (
        name
        and name == os.path.basename(name)
        and not name.startswith(".")
        and re.fullmatch(r"[A-Za-z0-9._-]+", name) is not None
    )


def sanitize_name(name, profile_kind="awg"):
    base = os.path.basename(name or "amnezia.conf").strip()
    base = re.sub(r"\s+", "-", base)
    base = re.sub(r"[^A-Za-z0-9._-]", "-", base)
    base = re.sub(r"-+", "-", base).strip(".-")
    if not base:
        base = "amnezia"
    wanted_extension = ".vless" if profile_kind == "vless" else ".conf"
    stem, extension = os.path.splitext(base)
    if extension.lower() not in (".conf", ".awg", ".txt", ".vless"):
        base += wanted_extension
    elif profile_kind == "vless" and extension.lower() != ".vless":
        base = stem + ".vless"
    return base[:96]


def unique_profile_name(name, profile_kind="awg"):
    safe = sanitize_name(name, profile_kind)
    stem, ext = os.path.splitext(safe)
    candidate = safe
    index = 2
    while os.path.exists(os.path.join(PROFILES_DIR, candidate)):
        candidate = "%s-%s%s" % (stem, index, ext or (".vless" if profile_kind == "vless" else ".conf"))
        index += 1
    return candidate


def profile_path(name):
    if not is_safe_name(name):
        fail("Invalid profile name")
    path = os.path.join(PROFILES_DIR, name)
    if not os.path.isfile(path):
        fail("Profile not found")
    return path


def file_hash(path):
    if not os.path.exists(path):
        return None
    digest = hashlib.sha256()
    with open(path, "rb") as file:
        for chunk in iter(lambda: file.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_config_data(data):
    if not data:
        fail("Config is empty")
    if len(data) > MAX_CONFIG_SIZE:
        fail("Config is too large")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("Config must be UTF-8 text")
    return data, text


def read_config(path):
    if path == "-":
        return read_config_data(sys.stdin.buffer.read(MAX_CONFIG_SIZE + 1))
    size = os.path.getsize(path)
    if size <= 0:
        fail("Config is empty")
    if size > MAX_CONFIG_SIZE:
        fail("Config is too large")
    with open(path, "rb") as file:
        return read_config_data(file.read())


def split_key(line):
    if "=" not in line:
        return None
    key = line.split("=", 1)[0].strip()
    return key.lower() if key else None


def append_missing_interface_defaults(output, keys):
    for key, value in INTERFACE_DEFAULTS:
        if key.lower() not in keys:
            output.append("%s = %s" % (key, value))


def normalize_config_text(text, omit_dns=False):
    output = []
    section = None
    interface_keys = set()
    interface_defaults_added = False

    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if section == "interface" and not interface_defaults_added:
                append_missing_interface_defaults(output, interface_keys)
                interface_defaults_added = True
            section = stripped.strip("[]").strip().lower()
            output.append(line)
            continue

        key = split_key(line)
        if section == "interface" and key:
            if key in UNSUPPORTED_INTERFACE_KEYS or (omit_dns and key == "dns"):
                continue
            interface_keys.add(key)

        output.append(line)

    if section == "interface" and not interface_defaults_added:
        append_missing_interface_defaults(output, interface_keys)

    return ("\n".join(output).rstrip() + "\n").encode("utf-8")


def runtime_config_data(data):
    return normalize_config_text(data.decode("utf-8"), omit_dns=True)


def runtime_profile_hash(path):
    try:
        with open(path, "rb") as file:
            data = file.read(MAX_CONFIG_SIZE + 1)
        if not data or len(data) > MAX_CONFIG_SIZE:
            return None
        return hashlib.sha256(runtime_config_data(data)).hexdigest()
    except (OSError, UnicodeDecodeError):
        return None


def validate_awg_config(path):
    data, text = read_config(path)
    lowered = text.lower()
    required = ("[interface]", "[peer]", "privatekey", "endpoint")
    missing = [item for item in required if item not in lowered]
    if missing:
        fail("Config does not look like an AmneziaWG profile: missing " + ", ".join(missing))
    return normalize_config_text(text)


def vless_uri_from_text(text):
    lines = [line.strip() for line in text.splitlines() if line.strip() and not line.lstrip().startswith("#")]
    if len(lines) != 1 or not lines[0].lower().startswith("vless://"):
        fail("VLESS profile must contain one vless:// URI")
    return lines[0]


def query_value(query, *names, default=""):
    for name in names:
        values = query.get(name)
        if values:
            return values[0]
    return default


def vless_config_from_uri(uri):
    try:
        parsed = urllib.parse.urlsplit(uri)
        query = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
        user_id = urllib.parse.unquote(parsed.username or "")
        uuid.UUID(user_id)
        server = parsed.hostname
        port = parsed.port
    except (ValueError, AttributeError) as exc:
        fail("Invalid VLESS URI: " + str(exc))
    if not server or not port:
        fail("VLESS URI must include a server and port")

    transport_type = query_value(query, "type", default="tcp").lower()
    if transport_type in ("", "tcp", "raw"):
        transport = None
    elif transport_type == "ws":
        transport = {"type": "ws", "path": query_value(query, "path", default="/")}
        host = query_value(query, "host")
        if host:
            transport["headers"] = {"Host": host}
    elif transport_type == "grpc":
        transport = {"type": "grpc", "service_name": query_value(query, "serviceName", "service_name")}
    else:
        fail("Unsupported VLESS transport: " + transport_type)

    security = query_value(query, "security", default="none").lower()
    tls = None
    if security in ("tls", "reality"):
        tls = {
            "enabled": True,
            "server_name": query_value(query, "sni", "serverName", default=server),
        }
        fingerprint = query_value(query, "fp", "fingerprint")
        if fingerprint:
            tls["utls"] = {"enabled": True, "fingerprint": fingerprint}
        if security == "reality":
            public_key = query_value(query, "pbk", "publicKey")
            short_id = query_value(query, "sid", "shortId")
            if not public_key:
                fail("VLESS Reality URI is missing public key (pbk)")
            tls["reality"] = {"enabled": True, "public_key": public_key, "short_id": short_id}
        alpn = [value for value in query_value(query, "alpn").split(",") if value]
        if alpn:
            tls["alpn"] = alpn
    elif security not in ("", "none"):
        fail("Unsupported VLESS security: " + security)

    outbound = {
        "type": "vless",
        "tag": "vless-out",
        "server": server,
        "server_port": port,
        "uuid": user_id,
    }
    flow = query_value(query, "flow")
    if flow:
        outbound["flow"] = flow
    packet_encoding = query_value(query, "packetEncoding", "packet_encoding")
    if packet_encoding:
        outbound["packet_encoding"] = packet_encoding
    if tls:
        outbound["tls"] = tls
    if transport:
        outbound["transport"] = transport

    return {
        "log": {"level": "info"},
        "inbounds": [{
            "type": "tun",
            "tag": "vless-tun",
            "interface_name": VLESS_IFACE,
            "address": "172.19.0.1/30",
            "mtu": 1280,
            "auto_route": False,
        }],
        "outbounds": [outbound],
        "route": {"auto_detect_interface": True, "final": "vless-out"},
    }


def validate_vless_config(path):
    _data, text = read_config(path)
    uri = vless_uri_from_text(text)
    config = vless_config_from_uri(uri)
    return (uri.rstrip() + "\n").encode("utf-8"), config


def profile_kind(path):
    try:
        _data, text = read_config(path)
    except OSError:
        return "unknown"
    return "vless" if text.lstrip().lower().startswith("vless://") else "awg"


def selected_vless_profile():
    value = read_text(VLESS_ACTIVE_PROFILE).strip()
    return value if is_safe_name(value) else None


def profile_meta(name, path, active_hash, active_vless):
    stat = os.stat(path)
    kind = profile_kind(path)
    return {
        "name": name,
        "type": "VLESS" if kind == "vless" else "AmneziaWG",
        "protocol": kind,
        "active": name == active_vless if kind == "vless" else (not active_vless and runtime_profile_hash(path) == active_hash),
        "size": stat.st_size,
        "mtime": int(stat.st_mtime),
    }


def list_profiles():
