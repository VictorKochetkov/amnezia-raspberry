def fail(message, status=1):
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    raise SystemExit(status)


def ok(payload=None):
    result = {"ok": True}
    if payload:
        result.update(payload)
    print(json.dumps(result, ensure_ascii=False))


def resolve_command(candidates):
    for candidate in candidates:
        if candidate.startswith("/") and os.path.exists(candidate):
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def run_command(args, check=True, timeout=30, input_text=None):
    return subprocess.run(
        args,
        check=check,
        input=input_text,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def read_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as file:
            return file.read()
    except OSError:
        return default


def atomic_write_text(path, text, mode=0o644):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o755, exist_ok=True)
    existing_mode = None
    try:
        existing_mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        pass

    descriptor, temporary_path = tempfile.mkstemp(prefix=".vpn-admin-", dir=directory, text=True)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary_path, existing_mode if existing_mode is not None else mode)
        os.replace(temporary_path, path)
    finally:
        if os.path.exists(temporary_path):
            os.unlink(temporary_path)


def fan_boot_config_path():
    candidates = [FAN_BOOT_CONFIG] if FAN_BOOT_CONFIG else [
        "/boot/firmware/config.txt",
        "/boot/config.txt",
    ]
    for path in candidates:
        if path and os.path.isfile(path):
            return path
    return None


def fan_config_block():
    lines = [
        FAN_CONFIG_BEGIN,
        "# Keep the fan enabled and let the kernel apply the temperature curve.",
        "dtparam=cooling_fan=on",
    ]
    for index, point in enumerate(FAN_CURVE):
        lines.extend([
            "dtparam=fan_temp%d=%d" % (index, point["temperature_c"] * 1000),
            "dtparam=fan_temp%d_hyst=%d" % (index, point["hysteresis_c"] * 1000),
            "dtparam=fan_temp%d_speed=%d" % (index, point["speed"]),
        ])
    lines.append(FAN_CONFIG_END)
    return "\n".join(lines)


def update_fan_boot_config():
    path = fan_boot_config_path()
    if not path:
        fail("Raspberry Pi boot config was not found")

    current = read_text(path)
    pattern = re.compile(
        r"^" + re.escape(FAN_CONFIG_BEGIN) + r"\n.*?^" + re.escape(FAN_CONFIG_END) + r"(?:\n|$)",
        re.MULTILINE | re.DOTALL,
    )
    current = pattern.sub("", current).rstrip()
    updated = (current + "\n\n" if current else "") + fan_config_block() + "\n"
    if updated != read_text(path):
        atomic_write_text(path, updated)
    return path


def read_int(path):
    try:
        return int(read_text(path).strip())
    except ValueError:
        return None


def find_pwm_fan():
    thermal_class = os.environ.get("VPN_ADMIN_THERMAL_CLASS", "/sys/class/thermal")
    try:
        entries = sorted(os.listdir(thermal_class))
    except OSError:
        return None
    for name in entries:
        if not name.startswith("cooling_device"):
            continue
        path = os.path.join(thermal_class, name)
        if read_text(os.path.join(path, "type")).strip() == "pwm-fan":
            return path
    return None


def find_pwm_fan_hwmon():
    hwmon_class = os.environ.get("VPN_ADMIN_HWMON_CLASS", "/sys/class/hwmon")
    try:
        entries = sorted(os.listdir(hwmon_class))
    except OSError:
        return None
    for name in entries:
        path = os.path.join(hwmon_class, name)
        if read_text(os.path.join(path, "name")).strip() == "pwmfan":
            return path
    return None


def read_fan_hwmon_status():
    path = find_pwm_fan_hwmon()
    if not path:
        return None
    return {
        "path": path,
        "enable_mode": read_int(os.path.join(path, "pwm1_enable")),
        "pwm": read_int(os.path.join(path, "pwm1")),
    }


def read_active_trip_temperatures():
    thermal_zone = os.environ.get("VPN_ADMIN_THERMAL_ZONE", "/sys/class/thermal/thermal_zone0")
    temperatures = []
    for index in range(16):
        trip_type = read_text(os.path.join(thermal_zone, "trip_point_%d_type" % index)).strip()
        if trip_type != "active":
            continue
        value = read_int(os.path.join(thermal_zone, "trip_point_%d_temp" % index))
        if value is not None:
            temperatures.append(value)
    return temperatures


def enable_runtime_fan():
    hwmon = read_fan_hwmon_status()
    if not hwmon:
        return False

    try:
        with open(os.path.join(hwmon["path"], "pwm1_enable"), "w", encoding="utf-8") as file:
            file.write("1\n")
        device = find_pwm_fan()
        temperature = read_int(os.environ.get("VPN_ADMIN_TEMP_FILE", "/sys/class/thermal/thermal_zone0/temp"))
        trips = read_active_trip_temperatures()
        if device and temperature is not None and trips:
            target_state = min(sum(temperature >= trip for trip in trips), len(FAN_CURVE))
            with open(os.path.join(device, "cur_state"), "w", encoding="utf-8") as file:
                file.write("%d\n" % target_state)
    except OSError as exc:
        fail("Failed to enable the running fan: " + str(exc))
    return True


def fan_status_payload():
    device = find_pwm_fan()
    hwmon = read_fan_hwmon_status()
    applied_enabled = bool(hwmon and hwmon.get("enable_mode") not in (None, 0))
    current_state = read_int(os.path.join(device, "cur_state")) if device else 0
    max_state = read_int(os.path.join(device, "max_state")) if device else 0
    current_state = current_state if current_state is not None else 0
    max_state = max_state if max_state is not None else 0

    if not applied_enabled:
        speed_percent = 0
    elif hwmon and hwmon.get("pwm") is not None:
        speed_percent = round(hwmon["pwm"] * 100 / 255)
    elif current_state <= 0:
        speed_percent = 0
    elif current_state <= len(FAN_CURVE):
        speed_percent = FAN_CURVE[current_state - 1]["speed_percent"]
    elif max_state:
        speed_percent = round(current_state * 100 / max_state)
    else:
        speed_percent = None

    restart_required = not applied_enabled
    active_temperatures = read_active_trip_temperatures()
    desired_temperatures = [point["temperature_c"] * 1000 for point in FAN_CURVE]
    if applied_enabled and active_temperatures:
        restart_required = restart_required or active_temperatures[:len(desired_temperatures)] != desired_temperatures

    return {
        "enabled": applied_enabled,
        "available": bool(device or hwmon),
        "applied": applied_enabled,
        "restart_required": restart_required,
        "speed_percent": speed_percent,
        "current_state": current_state,
        "max_state": max_state,
        "curve": list(FAN_CURVE),
    }


def read_fan_status():
    ok({"fan": fan_status_payload()})


def apply_fan_state():
    boot_config = update_fan_boot_config()
    runtime_applied = enable_runtime_fan()
    ok({"enabled": True, "runtime_applied": runtime_applied, "boot_config": boot_config})


def cpufreq_policy_paths():
    try:
        names = sorted(os.listdir(CPUFREQ_CLASS))
    except OSError:
        return []
    return [
        os.path.join(CPUFREQ_CLASS, name)
        for name in names
        if name.startswith("policy") and os.path.isdir(os.path.join(CPUFREQ_CLASS, name))
    ]


def cpufreq_status_payload():
    policy_paths = cpufreq_policy_paths()
    if not policy_paths:
        fail("No CPU frequency policies found")

    policies = []
    for path in policy_paths:
        policy = {
            "name": os.path.basename(path),
            "current_khz": read_int(os.path.join(path, "scaling_cur_freq")),
            "min_khz": read_int(os.path.join(path, "scaling_min_freq")),
            "max_khz": read_int(os.path.join(path, "scaling_max_freq")),
            "hardware_min_khz": read_int(os.path.join(path, "cpuinfo_min_freq")),
            "hardware_max_khz": read_int(os.path.join(path, "cpuinfo_max_freq")),
            "governor": read_text(os.path.join(path, "scaling_governor")).strip() or None,
        }
        policies.append(policy)

    hardware_mins = [item["hardware_min_khz"] or item["min_khz"] for item in policies]
    hardware_maxes = [item["hardware_max_khz"] or item["max_khz"] for item in policies]
    if any(value is None for value in hardware_mins + hardware_maxes):
        fail("CPU frequency range is unavailable")
    hardware_min_khz = max(hardware_mins)
    hardware_max_khz = min(hardware_maxes)

    available = set()
    for path in policy_paths:
        raw = read_text(os.path.join(path, "scaling_available_frequencies")).split()
        values = {int(value) for value in raw if value.isdigit()}
        if values:
            available = values if not available else available.intersection(values)
    if not available:
        step_khz = 100000
        start_khz = ((hardware_min_khz + step_khz - 1) // step_khz) * step_khz
        available.update(range(start_khz, hardware_max_khz + 1, step_khz))
    available.update((hardware_min_khz, hardware_max_khz))
    available = sorted(value for value in available if hardware_min_khz <= value <= hardware_max_khz)

    current_values = [item["current_khz"] for item in policies if item["current_khz"] is not None]
    max_values = [item["max_khz"] for item in policies if item["max_khz"] is not None]
    min_values = [item["min_khz"] for item in policies if item["min_khz"] is not None]
    governors = sorted({item["governor"] for item in policies if item["governor"]})
    return {
        "current_khz": max(current_values) if current_values else None,
        "min_khz": max(min_values) if min_values else hardware_min_khz,
        "max_khz": min(max_values) if max_values else hardware_max_khz,
        "hardware_min_khz": hardware_min_khz,
        "hardware_max_khz": hardware_max_khz,
        "configured_max_khz": read_int(CPUFREQ_CONFIG_FILE),
        "governor": ", ".join(governors) if governors else None,
        "available_max_khz": available,
        "policies": policies,
    }


def read_cpufreq_status():
    ok({"cpu_frequency": cpufreq_status_payload()})


def set_cpufreq_max(value):
    try:
        max_khz = int(value)
    except ValueError:
        fail("CPU maximum frequency must be an integer")

    status = cpufreq_status_payload()
    if max_khz not in status["available_max_khz"]:
        fail("Unsupported CPU maximum frequency")

    previous_exists = os.path.exists(CPUFREQ_CONFIG_FILE)
    previous = read_text(CPUFREQ_CONFIG_FILE)
    atomic_write_text(CPUFREQ_CONFIG_FILE, "%d\n" % max_khz)
    try:
        result = run_command([CPUFREQ_APPLY_COMMAND], check=False, timeout=20)
    except OSError as exc:
        result = None
        error = str(exc)
    else:
        error = (result.stderr or result.stdout or "Failed to apply CPU frequency").strip()

    if result is None or result.returncode != 0:
        if previous_exists:
            atomic_write_text(CPUFREQ_CONFIG_FILE, previous)
        else:
            try:
                os.unlink(CPUFREQ_CONFIG_FILE)
            except OSError:
                pass
        fail(error)

    ok({"cpu_frequency": cpufreq_status_payload()})


def current_default_iface():
    result = run_command(["ip", "route", "show", "default"], check=False, timeout=5)
    for line in result.stdout.splitlines():
        parts = line.split()
        if "dev" in parts:
            index = parts.index("dev")
            if index + 1 < len(parts):
                return parts[index + 1]
    return None


def load_source_state():
    try:
        with open(SOURCE_STATE_FILE, "r", encoding="utf-8") as file:
            state = json.load(file)
        if isinstance(state, dict):
            if state.get("mode") not in ("auto", "manual"):
                state["mode"] = "manual" if state.get("interface") else "auto"
            return state
    except (OSError, json.JSONDecodeError):
        pass
    return {
        "mode": "auto",
        "interface": current_default_iface() or DEFAULT_UPSTREAM_IFACE,
        "requested_interface": "",
        "kind": "ethernet",
        "name": "Auto",
    }


def save_source_state(source, mode="manual", requested_interface=None):
    os.makedirs(os.path.dirname(SOURCE_STATE_FILE), mode=0o755, exist_ok=True)
    payload = {
        "mode": mode,
        "interface": source["interface"],
        "requested_interface": requested_interface if mode == "manual" else "",
        "kind": source["kind"],
        "name": source["name"],
        "updated_at": int(time.time()),
    }
    with open(SOURCE_STATE_FILE, "w", encoding="utf-8") as file:
        json.dump(payload, file)
        file.write("\n")
    return payload


def nmcli_devices():
    result = run_command(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"],
        check=False,
        timeout=10,
    )
    devices = []
    for line in result.stdout.splitlines():
        parts = line.split(":", 3)
        if len(parts) != 4:
            continue
        device, dev_type, state, connection = parts
        devices.append({
            "interface": device,
            "type": dev_type,
            "state": state,
            "connection": "" if connection == "--" else connection,
        })
    return devices


def ap_wifi_ifaces():
    ifaces = set()
    for device in nmcli_devices():
        if device["connection"] == "RaspberryWiFi-AP":
            ifaces.add(device["interface"])
    if not ifaces and WIFI_IFACE:
        ifaces.add(WIFI_IFACE)
    return ifaces


def wifi_source_ifaces():
    excluded = ap_wifi_ifaces() | {AWG_IFACE, "lo"}
    return [
        device
        for device in nmcli_devices()
        if device["type"] == "wifi"
        and device["interface"] not in excluded
        and not device["interface"].startswith("p2p-dev-")
    ]


def ap_ssids():
    ssids = set()
    for device in nmcli_devices():
        if device["connection"] == "RaspberryWiFi-AP":
            ssid = connection_value("802-11-wireless.ssid", device["connection"])
            if ssid:
                ssids.add(ssid)
    return ssids


def source_kind(device):
    iface = device["interface"]
    dev_type = device["type"]
    if iface in ap_wifi_ifaces() or iface.startswith("p2p-dev-") or iface == AWG_IFACE or iface == "lo":
        return None
    if iface == "eth0":
        return "ethernet"
    if dev_type == "wifi":
        return "wifi"
    if dev_type in {"gsm", "cdma"}:
        return "usb-modem"
    if dev_type == "ethernet" and (iface != "eth0" or iface.startswith(USB_MODEM_PREFIXES)):
        return "usb-modem"
    if iface.startswith(USB_MODEM_PREFIXES):
        return "usb-modem"
    return None


def list_sources_payload():
    state = load_source_state()
    default_iface = current_default_iface()
    active_iface = state.get("interface")
    requested_iface = state.get("requested_interface") or active_iface
    sources = []
    for device in nmcli_devices():
        kind = source_kind(device)
        if not kind:
            continue
        iface = device["interface"]
        sources.append({
            "interface": iface,
            "kind": kind,
            "name": source_name_for(kind, device.get("connection")),
            "state": device["state"],
            "connection": device["connection"],
            "active": iface == active_iface,
            "requested": state.get("mode") == "manual" and iface == requested_iface,
            "default_route": iface == default_iface,
        })
    if not any(source["interface"] == "eth0" for source in sources):
        sources.insert(0, {
            "interface": "eth0",
            "kind": "ethernet",
            "name": "Ethernet",
            "state": "unavailable",
            "connection": "",
            "active": active_iface == "eth0",
            "requested": state.get("mode") == "manual" and requested_iface == "eth0",
            "default_route": default_iface == "eth0",
        })
    return {
        "sources": sources,
        "active": state,
        "mode": state.get("mode", "auto"),
        "default_route": default_iface,
    }


def list_sources():
    ok(list_sources_payload())


def connection_value(setting, connection):
    if not connection:
        return ""
    result = run_command(["nmcli", "-g", setting, "connection", "show", connection], check=False, timeout=5)
    return result.stdout.strip().splitlines()[0] if result.stdout.strip() else ""


def source_name_for(kind, connection=None):
    if kind == "ethernet":
        return "Ethernet"
    if kind == "usb-modem":
        return "USB modem"
    if kind == "wifi":
        ssid = connection_value("802-11-wireless.ssid", connection)
        if ssid:
            return ssid
        if connection and connection.startswith(WIFI_SOURCE_PREFIX):
            return connection[len(WIFI_SOURCE_PREFIX):]
        return "Wi-Fi"
    return "Internet source"


def kind_for_iface(iface):
    for device in nmcli_devices():
        if device["interface"] == iface:
            return source_kind(device)
    if iface == "eth0":
        return "ethernet"
    return "usb-modem"


def connection_name_for_wifi(ssid):
    digest = hashlib.sha1(ssid.encode("utf-8")).hexdigest()[:10]
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", ssid).strip(".-")[:40] or "network"
    return "%s%s-%s" % (WIFI_SOURCE_PREFIX, safe, digest)


def nmcli_unescape(value):
    result = []
    escaped = False
    for char in value:
        if escaped:
            result.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        else:
            result.append(char)
    if escaped:
        result.append("\\")
    return "".join(result)


def parse_nmcli_line(line, expected_fields):
    fields = []
    current = []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":" and len(fields) < expected_fields - 1:
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def list_wifi_networks():
    networks = {}
    wifi_ifaces = wifi_source_ifaces()
    own_ap_ssids = ap_ssids()
    for device in wifi_ifaces:
        iface = device["interface"]
        run_command(["nmcli", "device", "wifi", "rescan", "ifname", iface], check=False, timeout=15)
        result = run_command(
            ["nmcli", "-t", "-f", "SSID,SECURITY,SIGNAL,CHAN,IN-USE", "device", "wifi", "list", "ifname", iface],
            check=False,
            timeout=20,
        )
        for line in result.stdout.splitlines():
            parts = parse_nmcli_line(line, 5)
            if len(parts) != 5:
                continue
            ssid, security, signal, channel, in_use = parts
            ssid = nmcli_unescape(ssid).strip()
            if not ssid or ssid in own_ap_ssids:
                continue
            try:
                signal_value = int(signal)
            except ValueError:
                signal_value = 0
            key = (iface, ssid)
            item = networks.get(key)
            if item and item["signal"] >= signal_value:
                continue
            networks[key] = {
                "interface": iface,
                "ssid": ssid,
                "security": nmcli_unescape(security).strip(),
                "signal": signal_value,
                "channel": channel,
                "in_use": in_use == "*",
            }
    ok({
        "interfaces": [device["interface"] for device in wifi_ifaces],
