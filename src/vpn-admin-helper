def select_vless_profile(name, path):
    data, config = validate_vless_config(path)
    if not os.path.isfile(SING_BOX):
        fail("sing-box is not installed")
    os.makedirs(VLESS_DIR, mode=0o700, exist_ok=True)
    awg_was_active = run_text(["systemctl", "is-active", AWG_SERVICE], timeout=4).stdout.strip() == "active"
    descriptor, temporary_path = tempfile.mkstemp(prefix=".vless-", suffix=".json", dir=VLESS_DIR, text=True)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            json.dump(config, file, ensure_ascii=False, indent=2)
            file.write("\n")
        os.chmod(temporary_path, 0o600)
        result = run_command([SING_BOX, "check", "-c", temporary_path], check=False, timeout=15)
        if result.returncode != 0:
            fail("Invalid VLESS configuration: " + (result.stderr or result.stdout).strip())
        os.replace(temporary_path, VLESS_CONFIG)
        with open(path, "wb") as file:
            file.write(data)
        os.chmod(path, 0o600)
        atomic_write_text(VLESS_ACTIVE_PROFILE, name + "\n", mode=0o600)
        subprocess.run(["systemctl", "disable", "--now", AWG_SERVICE], check=False, timeout=30)
        subprocess.run(["systemctl", "enable", VLESS_SERVICE], check=False, timeout=15)
        restart_vless()
    except subprocess.CalledProcessError as exc:
        subprocess.run(["systemctl", "disable", "--now", VLESS_SERVICE], check=False, timeout=30)
        if os.path.exists(VLESS_ACTIVE_PROFILE):
            os.remove(VLESS_ACTIVE_PROFILE)
        if awg_was_active:
            subprocess.run(["systemctl", "enable", "--now", AWG_SERVICE], check=False, timeout=30)
        fail("Failed to start VLESS service: " + str(exc))
    finally:
        if os.path.exists(temporary_path):
            os.unlink(temporary_path)
    ok({"active": name})


