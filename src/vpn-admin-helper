#!/usr/bin/env python3
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time


CONFIG_DIR = os.environ.get("VPN_CONFIG_DIR", "/etc/amnezia/amneziawg")
PROFILES_DIR = os.environ.get("VPN_PROFILES_DIR", os.path.join(CONFIG_DIR, "profiles"))
ACTIVE_CONFIG = os.environ.get("VPN_ACTIVE_CONFIG", os.path.join(CONFIG_DIR, "awg0.conf"))
AWG_SERVICE = os.environ.get("VPN_AWG_SERVICE", "awg-quick@awg0.service")
AWG_IFACE = os.environ.get("VPN_AWG_IFACE", "awg0")
STALE_HANDSHAKE_SECONDS = int(os.environ.get("VPN_STALE_HANDSHAKE_SECONDS", "180"))
MAX_CONFIG_SIZE = 256 * 1024
NFT_TABLE_FAMILY = os.environ.get("VPN_NFT_TABLE_FAMILY", "inet")
NFT_TABLE = os.environ.get("VPN_NFT_TABLE", "vpn_router")
NFT_FORWARD_CHAIN = os.environ.get("VPN_NFT_FORWARD_CHAIN", "forward")
WIFI_IFACE = os.environ.get("VPN_ADMIN_WIFI_IFACE", "wlan0")
DEFAULT_UPSTREAM_IFACE = os.environ.get("VPN_UPSTREAM_IFACE", "eth0")
SOURCE_STATE_FILE = os.environ.get("VPN_SOURCE_STATE_FILE", "/etc/amnezia/router-source.json")
NFT_TEMPLATE_FILE = os.environ.get("VPN_NFT_TEMPLATE_FILE", "/etc/amnezia/vpn-router.nft.template")
NFTABLES_FILE = os.environ.get("VPN_NFTABLES_FILE", "/etc/nftables.conf")
INTERFACE_DEFAULTS = (
    ("MTU", "1280"),
    ("Table", "off"),
    ("PostUp", "ip route replace default dev %i table 51820; ip rule add fwmark 0x1 table 51820 priority 100 2>/dev/null || true"),
    ("PreDown", "ip rule del fwmark 0x1 table 51820 priority 100 2>/dev/null || true; ip route del default dev %i table 51820 2>/dev/null || true"),
)
UNSUPPORTED_INTERFACE_KEYS = {"i2", "i3", "i4", "i5"}
USB_MODEM_PREFIXES = ("usb", "wwan", "wwp", "enx")


def fail(message, status=1):
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    raise SystemExit(status)


def ok(payload=None):
    result = {"ok": True}
    if payload:
        result.update(payload)
    print(json.dumps(result, ensure_ascii=False))


def resolve_command(candidates):
    for candidate in candidates:
        if candidate.startswith("/") and os.path.exists(candidate):
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def run_command(args, check=True, timeout=30, input_text=None):
    return subprocess.run(
        args,
        check=check,
        input=input_text,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def current_default_iface():
    result = run_command(["ip", "route", "show", "default"], check=False, timeout=5)
    for line in result.stdout.splitlines():
        parts = line.split()
        if "dev" in parts:
            index = parts.index("dev")
            if index + 1 < len(parts):
                return parts[index + 1]
    return None


def load_source_state():
    try:
        with open(SOURCE_STATE_FILE, "r", encoding="utf-8") as file:
            state = json.load(file)
        if isinstance(state, dict):
            return state
    except (OSError, json.JSONDecodeError):
        pass
    return {"interface": current_default_iface() or DEFAULT_UPSTREAM_IFACE, "kind": "ethernet"}


def save_source_state(source):
    os.makedirs(os.path.dirname(SOURCE_STATE_FILE), mode=0o755, exist_ok=True)
    payload = {
        "interface": source["interface"],
        "kind": source["kind"],
        "name": source["name"],
        "updated_at": int(time.time()),
    }
    with open(SOURCE_STATE_FILE, "w", encoding="utf-8") as file:
        json.dump(payload, file)
        file.write("\n")
    return payload


def nmcli_devices():
    result = run_command(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"],
        check=False,
        timeout=10,
    )
    devices = []
    for line in result.stdout.splitlines():
        parts = line.split(":", 3)
        if len(parts) != 4:
            continue
        device, dev_type, state, connection = parts
        devices.append({
            "interface": device,
            "type": dev_type,
            "state": state,
            "connection": "" if connection == "--" else connection,
        })
    return devices


def source_kind(device):
    iface = device["interface"]
    dev_type = device["type"]
    if iface == WIFI_IFACE or iface.startswith("p2p-dev-") or iface == AWG_IFACE or iface == "lo":
        return None
    if iface == "eth0":
        return "ethernet"
    if dev_type in {"gsm", "cdma"}:
        return "usb-modem"
    if dev_type == "ethernet" and (iface != "eth0" or iface.startswith(USB_MODEM_PREFIXES)):
        return "usb-modem"
    if iface.startswith(USB_MODEM_PREFIXES):
        return "usb-modem"
    return None


def list_sources_payload():
    state = load_source_state()
    default_iface = current_default_iface()
    sources = []
    for device in nmcli_devices():
        kind = source_kind(device)
        if not kind:
            continue
        iface = device["interface"]
        sources.append({
            "interface": iface,
            "kind": kind,
            "name": "Ethernet" if kind == "ethernet" else "USB modem",
            "state": device["state"],
            "connection": device["connection"],
            "active": iface == state.get("interface"),
            "default_route": iface == default_iface,
        })
    if not any(source["interface"] == "eth0" for source in sources):
        sources.insert(0, {
            "interface": "eth0",
            "kind": "ethernet",
            "name": "Ethernet",
            "state": "unavailable",
            "connection": "",
            "active": state.get("interface") == "eth0",
            "default_route": default_iface == "eth0",
        })
    return {
        "sources": sources,
        "active": state,
        "default_route": default_iface,
    }


def list_sources():
    ok(list_sources_payload())


def nmcli_connect_source(source):
    iface = source["interface"]
    devices = {device["interface"]: device for device in nmcli_devices()}
    connection = devices.get(iface, {}).get("connection")
    if not connection:
        connection = "USB-Modem-%s" % iface if source["kind"] == "usb-modem" else iface
        run_command(["nmcli", "connection", "delete", connection], check=False, timeout=10)
        run_command([
            "nmcli", "connection", "add",
            "type", "ethernet",
            "ifname", iface,
            "con-name", connection,
            "autoconnect", "yes",
            "ipv4.method", "auto",
            "ipv4.route-metric", "10",
            "ipv6.method", "disabled",
        ], check=False, timeout=20)
    run_command(["nmcli", "device", "connect", iface], check=False, timeout=30)
    if connection:
        run_command(["nmcli", "connection", "modify", connection, "connection.autoconnect", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.never-default", "no"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv4.route-metric", "10"], check=False, timeout=10)
        run_command(["nmcli", "connection", "modify", connection, "ipv6.never-default", "yes"], check=False, timeout=10)
        run_command(["nmcli", "connection", "up", connection], check=False, timeout=45)
    for other in list_sources_payload()["sources"]:
        other_connection = other.get("connection")
        if other["interface"] == iface or not other_connection:
            continue
        run_command(["nmcli", "connection", "modify", other_connection, "ipv4.route-metric", "700"], check=False, timeout=10)
        run_command(["nmcli", "device", "reapply", other["interface"]], check=False, timeout=10)


def render_nftables(upstream_iface):
    if not os.path.exists(NFT_TEMPLATE_FILE):
        fail("nftables template is missing; redeploy the admin package")
    with open(NFT_TEMPLATE_FILE, "r", encoding="utf-8") as file:
        rendered = file.read()
    rendered = rendered.replace("@WIFI_IFACE@", WIFI_IFACE).replace("@UPSTREAM_IFACE@", upstream_iface)
    tmp_path = os.path.join(os.path.dirname(SOURCE_STATE_FILE), "nftables.conf.tmp")
    with open(tmp_path, "w", encoding="utf-8") as file:
        file.write(rendered)
    run_command(["nft", "-c", "-f", tmp_path], timeout=10)
    with open(NFTABLES_FILE, "w", encoding="utf-8") as file:
        file.write(rendered)
    os.chmod(NFTABLES_FILE, 0o644)
    try:
        os.remove(tmp_path)
    except OSError:
        pass
    run_command(["nft", "delete", "table", "inet", NFT_TABLE], check=False, timeout=10)
    run_command(["nft", "delete", "table", "ip", "vpn_router_nat"], check=False, timeout=10)
    run_command(["nft", "-f", NFTABLES_FILE], timeout=10)


def select_source(interface):
    sources = list_sources_payload()["sources"]
    source = next((item for item in sources if item["interface"] == interface), None)
    if not source:
        fail("Unknown internet source")
    nmcli_connect_source(source)
    state = save_source_state(source)
    run_command(["systemctl", "start", "vpn-router-source-apply.service"], timeout=90)
    ok({**list_sources_payload(), "selected": state})


def ensure_dirs():
    os.makedirs(PROFILES_DIR, mode=0o700, exist_ok=True)
    os.chmod(PROFILES_DIR, 0o700)
    if os.path.exists(ACTIVE_CONFIG) and not list(profile_paths()):
        target = unique_profile_name("current.conf")
        shutil.copy2(ACTIVE_CONFIG, os.path.join(PROFILES_DIR, target))
        os.chmod(os.path.join(PROFILES_DIR, target), 0o600)


def profile_paths():
    if not os.path.isdir(PROFILES_DIR):
        return
    for name in sorted(os.listdir(PROFILES_DIR)):
        path = os.path.join(PROFILES_DIR, name)
        if is_safe_name(name) and os.path.isfile(path):
            yield name, path


def is_safe_name(name):
    return (
        name
        and name == os.path.basename(name)
        and not name.startswith(".")
        and re.fullmatch(r"[A-Za-z0-9._-]+", name) is not None
    )


def sanitize_name(name):
    base = os.path.basename(name or "amnezia.conf").strip()
    base = re.sub(r"\s+", "-", base)
    base = re.sub(r"[^A-Za-z0-9._-]", "-", base)
    base = re.sub(r"-+", "-", base).strip(".-")
    if not base:
        base = "amnezia"
    if not base.lower().endswith(".conf"):
        base += ".conf"
    return base[:96]


def unique_profile_name(name):
    safe = sanitize_name(name)
    stem, ext = os.path.splitext(safe)
    candidate = safe
    index = 2
    while os.path.exists(os.path.join(PROFILES_DIR, candidate)):
        candidate = "%s-%s%s" % (stem, index, ext or ".conf")
        index += 1
    return candidate


def profile_path(name):
    if not is_safe_name(name):
        fail("Invalid profile name")
    path = os.path.join(PROFILES_DIR, name)
    if not os.path.isfile(path):
        fail("Profile not found")
    return path


def file_hash(path):
    if not os.path.exists(path):
        return None
    digest = hashlib.sha256()
    with open(path, "rb") as file:
        for chunk in iter(lambda: file.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_config_data(data):
    if not data:
        fail("Config is empty")
    if len(data) > MAX_CONFIG_SIZE:
        fail("Config is too large")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("Config must be UTF-8 text")
    return data, text


def read_config(path):
    if path == "-":
        return read_config_data(sys.stdin.buffer.read(MAX_CONFIG_SIZE + 1))
    size = os.path.getsize(path)
    if size <= 0:
        fail("Config is empty")
    if size > MAX_CONFIG_SIZE:
        fail("Config is too large")
    with open(path, "rb") as file:
        return read_config_data(file.read())


def split_key(line):
    if "=" not in line:
        return None
    key = line.split("=", 1)[0].strip()
    return key.lower() if key else None


def append_missing_interface_defaults(output, keys):
    for key, value in INTERFACE_DEFAULTS:
        if key.lower() not in keys:
            output.append("%s = %s" % (key, value))


def normalize_config_text(text):
    output = []
    section = None
    interface_keys = set()
    interface_defaults_added = False

    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if section == "interface" and not interface_defaults_added:
                append_missing_interface_defaults(output, interface_keys)
                interface_defaults_added = True
            section = stripped.strip("[]").strip().lower()
            output.append(line)
            continue

        key = split_key(line)
        if section == "interface" and key:
            if key in UNSUPPORTED_INTERFACE_KEYS:
                continue
            interface_keys.add(key)

        output.append(line)

    if section == "interface" and not interface_defaults_added:
        append_missing_interface_defaults(output, interface_keys)

    return ("\n".join(output).rstrip() + "\n").encode("utf-8")


def validate_config(path):
    data, text = read_config(path)
    lowered = text.lower()
    required = ("[interface]", "[peer]", "privatekey", "endpoint")
    missing = [item for item in required if item not in lowered]
    if missing:
        fail("Config does not look like an AmneziaWG profile: missing " + ", ".join(missing))
    return normalize_config_text(text)


def profile_meta(name, path, active_hash):
    stat = os.stat(path)
    return {
        "name": name,
        "active": file_hash(path) == active_hash,
        "size": stat.st_size,
        "mtime": int(stat.st_mtime),
    }


def list_profiles():
    ensure_dirs()
    active_hash = file_hash(ACTIVE_CONFIG)
    profiles = [profile_meta(name, path, active_hash) for name, path in profile_paths()]
    active = next((profile["name"] for profile in profiles if profile["active"]), None)
    ok({"active": active, "profiles": profiles})


def import_profile(source_path, original_name):
    ensure_dirs()
    data = validate_config(source_path)
    name = unique_profile_name(original_name)
    target = os.path.join(PROFILES_DIR, name)
    with open(target, "wb") as file:
        file.write(data)
    os.chmod(target, 0o600)
    active_hash = file_hash(ACTIVE_CONFIG)
    ok({"profile": profile_meta(name, target, active_hash)})


def restart_vpn():
    subprocess.run(["systemctl", "restart", AWG_SERVICE], check=True, timeout=30)
    subprocess.run(["systemctl", "start", "vpn-split-update.service"], check=False, timeout=60)


def select_profile(name):
    ensure_dirs()
    path = profile_path(name)
    data = validate_config(path)
    backup = ACTIVE_CONFIG + ".admin-backup-" + time.strftime("%Y%m%d%H%M%S")
    if os.path.exists(ACTIVE_CONFIG):
        shutil.copy2(ACTIVE_CONFIG, backup)
        os.chmod(backup, 0o600)
    with open(path, "wb") as file:
        file.write(data)
    os.chmod(path, 0o600)
    with open(ACTIVE_CONFIG, "wb") as file:
        file.write(data)
    os.chmod(ACTIVE_CONFIG, 0o600)
    try:
        restart_vpn()
    except subprocess.CalledProcessError as exc:
        if os.path.exists(backup):
            shutil.copy2(backup, ACTIVE_CONFIG)
            os.chmod(ACTIVE_CONFIG, 0o600)
            subprocess.run(["systemctl", "restart", AWG_SERVICE], check=False, timeout=30)
        fail("Failed to restart VPN service: " + str(exc))
    ok({"active": name})


def delete_profile(name):
    ensure_dirs()
    path = profile_path(name)
    active_hash = file_hash(ACTIVE_CONFIG)
    if file_hash(path) == active_hash:
        fail("Cannot delete active profile")
    os.remove(path)
    ok({"deleted": name})


def run_text(command, timeout=5):
    try:
        return subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(command, 1, "", str(exc))


def service_state():
    active = run_text(["systemctl", "is-active", AWG_SERVICE], timeout=4)
    failed = run_text(["systemctl", "is-failed", AWG_SERVICE], timeout=4)
    return {
        "name": AWG_SERVICE,
        "active": active.stdout.strip() or "unknown",
        "failed": failed.stdout.strip() or "unknown",
    }


def interface_exists():
    result = run_text(["ip", "link", "show", AWG_IFACE], timeout=4)
    return result.returncode == 0


def parse_duration_seconds(value):
    value = value.strip().lower()
    if not value or value == "(none)":
        return None
    total = 0
    for amount, unit in re.findall(r"(\d+)\s+([a-z]+)", value):
        number = int(amount)
        if unit.startswith("second"):
            total += number
        elif unit.startswith("minute"):
            total += number * 60
        elif unit.startswith("hour"):
            total += number * 3600
        elif unit.startswith("day"):
            total += number * 86400
    return total if total else None


def parse_awg_show(output):
    status = {
        "endpoint": None,
        "latest_handshake": None,
        "latest_handshake_seconds": None,
        "transfer": None,
    }
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("endpoint:"):
            status["endpoint"] = line.split(":", 1)[1].strip()
        elif line.startswith("latest handshake:"):
            value = line.split(":", 1)[1].strip()
            status["latest_handshake"] = value
            status["latest_handshake_seconds"] = parse_duration_seconds(value)
        elif line.startswith("transfer:"):
            status["transfer"] = line.split(":", 1)[1].strip()
    return status


def read_vpn_status():
    service = service_state()
    has_interface = interface_exists()
    awg = resolve_command(("awg", "wg"))
    show = {}
    error = None

    if awg and has_interface:
        result = run_text([awg, "show", AWG_IFACE], timeout=5)
        if result.returncode == 0:
            show = parse_awg_show(result.stdout)
        else:
            error = (result.stderr or result.stdout or "Failed to read VPN interface").strip()
    elif not awg:
        error = "awg/wg command not found"

    handshake_seconds = show.get("latest_handshake_seconds")
    if service["failed"] == "failed" or service["active"] == "failed":
        state = "error"
        label = "VPN error"
    elif service["active"] in ("inactive", "deactivating"):
        state = "disconnected"
        label = "VPN disconnected"
    elif service["active"] == "activating":
        state = "connecting"
        label = "VPN connecting"
    elif service["active"] == "active" and has_interface and handshake_seconds is not None:
        if handshake_seconds <= STALE_HANDSHAKE_SECONDS:
            state = "connected"
            label = "VPN connected"
        else:
            state = "connecting"
            label = "VPN stale"
    elif service["active"] == "active" and has_interface:
        state = "connecting"
        label = "VPN connecting"
    else:
        state = "disconnected"
        label = "VPN disconnected"

    ok({
        "vpn_status": {
            "state": state,
            "label": label,
            "service": service,
            "interface": {"name": AWG_IFACE, "exists": has_interface},
            "endpoint": show.get("endpoint"),
            "latest_handshake": show.get("latest_handshake"),
            "latest_handshake_seconds": handshake_seconds,
            "transfer": show.get("transfer"),
            "stale_after_seconds": STALE_HANDSHAKE_SECONDS,
            "error": error,
        }
    })


def expr_match_value(expr, meta_key):
    match = expr.get("match")
    if not match:
        return None
    left = match.get("left")
    if not isinstance(left, dict):
        return None
    meta = left.get("meta")
    if not isinstance(meta, dict) or meta.get("key") != meta_key:
        return None
    return match.get("right")


def rule_interfaces(exprs):
    iif = None
    oif = None
    for expr in exprs:
        value = expr_match_value(expr, "iifname")
        if value is not None:
            iif = value
        value = expr_match_value(expr, "oifname")
        if value is not None:
            oif = value
    return iif, oif


def rule_counter(exprs):
    for expr in exprs:
        counter = expr.get("counter")
        if isinstance(counter, dict):
            return {
                "packets": int(counter.get("packets", 0)),
                "bytes": int(counter.get("bytes", 0)),
            }
    return {"packets": 0, "bytes": 0}


def read_traffic():
    upstream_iface = load_source_state().get("interface") or DEFAULT_UPSTREAM_IFACE
    result = subprocess.run(
        ["nft", "-j", "list", "chain", NFT_TABLE_FAMILY, NFT_TABLE, NFT_FORWARD_CHAIN],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or "Failed to read nft counters").strip())

    payload = json.loads(result.stdout)
    traffic = {
        "vpn": {"bytes": 0, "packets": 0},
        "direct": {"bytes": 0, "packets": 0},
    }

    for item in payload.get("nftables", []):
        rule = item.get("rule")
        if not rule:
            continue
        exprs = rule.get("expr", [])
        iif, oif = rule_interfaces(exprs)
        counter = rule_counter(exprs)

        if (iif, oif) in ((WIFI_IFACE, "awg0"), ("awg0", WIFI_IFACE)):
            bucket = traffic["vpn"]
        elif (iif, oif) in ((WIFI_IFACE, upstream_iface), (upstream_iface, WIFI_IFACE)):
            bucket = traffic["direct"]
        else:
            continue

        bucket["bytes"] += counter["bytes"]
        bucket["packets"] += counter["packets"]

    total = traffic["vpn"]["bytes"] + traffic["direct"]["bytes"]
    ok({"traffic": {**traffic, "total_bytes": total}})


def main():
    if len(sys.argv) < 2:
        fail("Missing action")

    action = sys.argv[1]
    if action == "list":
        list_profiles()
    elif action == "status":
        read_vpn_status()
    elif action == "traffic":
        read_traffic()
    elif action == "sources":
        list_sources()
    elif action == "source-select" and len(sys.argv) == 3:
        select_source(sys.argv[2])
    elif action == "import" and len(sys.argv) == 4:
        import_profile(sys.argv[2], sys.argv[3])
    elif action == "select" and len(sys.argv) == 3:
        select_profile(sys.argv[2])
    elif action == "delete" and len(sys.argv) == 3:
        delete_profile(sys.argv[2])
    else:
        fail("Unsupported action")


if __name__ == "__main__":
    main()
