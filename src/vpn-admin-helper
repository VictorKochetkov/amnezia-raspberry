def run_text(command, timeout=5):
    try:
        return subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(command, 1, "", str(exc))


def service_state():
    service = VLESS_SERVICE if selected_vless_profile() else AWG_SERVICE
    active = run_text(["systemctl", "is-active", service], timeout=4)
    failed = run_text(["systemctl", "is-failed", service], timeout=4)
    return {
        "name": service,
        "active": active.stdout.strip() or "unknown",
        "failed": failed.stdout.strip() or "unknown",
    }


def interface_exists():
    interface = VLESS_IFACE if selected_vless_profile() else AWG_IFACE
    result = run_text(["ip", "link", "show", interface], timeout=4)
    return result.returncode == 0


def parse_duration_seconds(value):
    value = value.strip().lower()
    if not value or value == "(none)":
        return None
    total = 0
    for amount, unit in re.findall(r"(\d+)\s+([a-z]+)", value):
        number = int(amount)
        if unit.startswith("second"):
            total += number
        elif unit.startswith("minute"):
            total += number * 60
        elif unit.startswith("hour"):
            total += number * 3600
        elif unit.startswith("day"):
            total += number * 86400
    return total if total else None


def parse_awg_show(output):
    status = {
        "endpoint": None,
        "latest_handshake": None,
        "latest_handshake_seconds": None,
        "transfer": None,
    }
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("endpoint:"):
            status["endpoint"] = line.split(":", 1)[1].strip()
        elif line.startswith("latest handshake:"):
            value = line.split(":", 1)[1].strip()
            status["latest_handshake"] = value
            status["latest_handshake_seconds"] = parse_duration_seconds(value)
        elif line.startswith("transfer:"):
            status["transfer"] = line.split(":", 1)[1].strip()
    return status


def read_vpn_status():
    protocol = "vless" if selected_vless_profile() else "awg"
    interface = VLESS_IFACE if protocol == "vless" else AWG_IFACE
    service = service_state()
    has_interface = interface_exists()
    awg = resolve_command(("awg", "wg"))
    show = {}
    error = None

    if protocol == "awg" and awg and has_interface:
        result = run_text([awg, "show", interface], timeout=5)
        if result.returncode == 0:
            show = parse_awg_show(result.stdout)
        else:
            error = (result.stderr or result.stdout or "Failed to read VPN interface").strip()
    elif protocol == "awg" and not awg:
        error = "awg/wg command not found"

    handshake_seconds = show.get("latest_handshake_seconds")
    if service["failed"] == "failed" or service["active"] == "failed":
        state = "error"
        label = "VPN error"
    elif service["active"] in ("inactive", "deactivating"):
        state = "disconnected"
        label = "VPN disconnected"
    elif service["active"] == "activating":
        state = "connecting"
        label = "VPN connecting"
    elif protocol == "vless" and service["active"] == "active" and has_interface:
        state = "connected"
        label = "VPN connected"
    elif service["active"] == "active" and has_interface and handshake_seconds is not None:
        if handshake_seconds <= STALE_HANDSHAKE_SECONDS:
            state = "connected"
            label = "VPN connected"
        else:
            state = "connecting"
            label = "VPN stale"
    elif service["active"] == "active" and has_interface:
        state = "connecting"
        label = "VPN connecting"
    else:
        state = "disconnected"
        label = "VPN disconnected"

    ok({
        "vpn_status": {
            "state": state,
            "label": label,
            "protocol": protocol,
            "service": service,
            "interface": {"name": interface, "exists": has_interface},
            "endpoint": show.get("endpoint"),
            "latest_handshake": show.get("latest_handshake"),
            "latest_handshake_seconds": handshake_seconds,
            "transfer": show.get("transfer"),
            "stale_after_seconds": STALE_HANDSHAKE_SECONDS,
            "error": error,
        }
    })


def expr_match_value(expr, meta_key):
    match = expr.get("match")
    if not match:
        return None
    left = match.get("left")
    if not isinstance(left, dict):
        return None
    meta = left.get("meta")
    if not isinstance(meta, dict) or meta.get("key") != meta_key:
        return None
    return match.get("right")


def rule_interfaces(exprs):
    iif = None
    oif = None
    for expr in exprs:
        value = expr_match_value(expr, "iifname")
        if value is not None:
            iif = value
        value = expr_match_value(expr, "oifname")
        if value is not None:
            oif = value
    return iif, oif


def rule_counter(exprs):
    for expr in exprs:
        counter = expr.get("counter")
        if isinstance(counter, dict):
            return {
                "packets": int(counter.get("packets", 0)),
                "bytes": int(counter.get("bytes", 0)),
            }
    return {"packets": 0, "bytes": 0}


def read_traffic():
    upstream_iface = load_source_state().get("interface") or DEFAULT_UPSTREAM_IFACE
    result = subprocess.run(
        ["nft", "-j", "list", "chain", NFT_TABLE_FAMILY, NFT_TABLE, NFT_FORWARD_CHAIN],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or "Failed to read nft counters").strip())

    payload = json.loads(result.stdout)
    traffic = {
        "vpn": {"bytes": 0, "packets": 0},
        "direct": {"bytes": 0, "packets": 0},
    }

    for item in payload.get("nftables", []):
        rule = item.get("rule")
        if not rule:
            continue
        exprs = rule.get("expr", [])
        iif, oif = rule_interfaces(exprs)
        counter = rule_counter(exprs)

        if (iif, oif) in (
            (WIFI_IFACE, "awg0"), ("awg0", WIFI_IFACE),
            (WIFI_IFACE, "vless0"), ("vless0", WIFI_IFACE),
        ):
            bucket = traffic["vpn"]
        elif (iif, oif) in ((WIFI_IFACE, upstream_iface), (upstream_iface, WIFI_IFACE)):
            bucket = traffic["direct"]
        else:
            continue

        bucket["bytes"] += counter["bytes"]
        bucket["packets"] += counter["packets"]

    total = traffic["vpn"]["bytes"] + traffic["direct"]["bytes"]
    ok({"traffic": {**traffic, "total_bytes": total}})


def main():
    if len(sys.argv) < 2:
        fail("Missing action")

    action = sys.argv[1]
    if action == "list":
        list_profiles()
    elif action == "status":
        read_vpn_status()
    elif action == "traffic":
        read_traffic()
    elif action == "sources":
        list_sources()
    elif action == "source-select" and len(sys.argv) == 3:
        select_source(sys.argv[2])
    elif action == "wifi-scan":
        list_wifi_networks()
    elif action == "wifi-connect" and len(sys.argv) == 3:
        payload = json.load(sys.stdin)
        connect_wifi_source(sys.argv[2], payload.get("ssid"), payload.get("password", ""))
    elif action == "vpn-reconnect":
        reconnect_vpn()
    elif action == "fan-status":
        read_fan_status()
    elif action == "fan-apply":
        apply_fan_state()
    elif action == "cpufreq-status":
        read_cpufreq_status()
    elif action == "cpufreq-set" and len(sys.argv) == 3:
        set_cpufreq_max(sys.argv[2])
    elif action == "reboot":
        reboot_system()
    elif action == "import" and len(sys.argv) == 4:
        import_profile(sys.argv[2], sys.argv[3])
    elif action == "select" and len(sys.argv) == 3:
        select_profile(sys.argv[2])
    elif action == "delete" and len(sys.argv) == 3:
        delete_profile(sys.argv[2])
    else:
        fail("Unsupported action")


if __name__ == "__main__":
    main()
