            shutil.copy2(backup, ACTIVE_CONFIG)
            os.chmod(ACTIVE_CONFIG, 0o600)
            subprocess.run(["systemctl", "restart", AWG_SERVICE], check=False, timeout=30)
        fail("Failed to restart VPN service: " + str(exc))
