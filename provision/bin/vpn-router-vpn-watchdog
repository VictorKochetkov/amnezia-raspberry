#!/usr/bin/env python3
import json
import os
import subprocess
import time


STATUS_SNAPSHOT = os.environ.get("VPN_ADMIN_STATUS_SNAPSHOT", "/usr/local/sbin/vpn-admin-status-snapshot")
STATUS_FILE = os.environ.get("VPN_ADMIN_STATUS_FILE", "/run/vpn-admin/vpn-status.json")
AWG_SERVICE = os.environ.get("VPN_AWG_SERVICE", "awg-quick@awg0.service")
STATE_FILE = os.environ.get("VPN_WATCHDOG_STATE_FILE", "/run/vpn-admin/vpn-watchdog.json")
RESTART_AFTER_SECONDS = int(os.environ.get("VPN_WATCHDOG_RESTART_AFTER_SECONDS", "90"))


def run(command, timeout=45):
    return subprocess.run(command, check=False, capture_output=True, text=True, timeout=timeout)


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as file:
            return json.load(file)
    except (OSError, json.JSONDecodeError):
        return {}


def write_json(path, payload):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    tmp_path = path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as file:
        json.dump(payload, file, ensure_ascii=False)
        file.write("\n")
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)


def refresh_status():
    run([STATUS_SNAPSHOT], timeout=15)
    payload = read_json(STATUS_FILE)
    status = payload.get("vpn_status")
    return status if isinstance(status, dict) else {}


def main():
    now = int(time.time())
    status = refresh_status()
    state = status.get("state")
    label = status.get("label") or "VPN unknown"
    watchdog = read_json(STATE_FILE)

    if state == "connected":
        write_json(STATE_FILE, {
            "bad_since": None,
            "last_state": state,
            "last_label": label,
            "last_checked_at": now,
            "last_restart_at": watchdog.get("last_restart_at"),
            "last_restart_reason": watchdog.get("last_restart_reason"),
        })
        return

    bad_since = watchdog.get("bad_since") or now
    should_restart = now - int(bad_since) >= RESTART_AFTER_SECONDS
    payload = {
        "bad_since": bad_since,
        "last_state": state,
        "last_label": label,
        "last_checked_at": now,
        "last_restart_at": watchdog.get("last_restart_at"),
        "last_restart_reason": watchdog.get("last_restart_reason"),
    }

    if should_restart:
        reason = "%s (%s)" % (label, state or "unknown")
        service = (status.get("service") or {}).get("name") or AWG_SERVICE
        result = run(["systemctl", "restart", service], timeout=45)
        run(["systemctl", "start", "vpn-split-update.service"], timeout=60)
        payload.update({
            "bad_since": None,
            "last_restart_at": now,
            "last_restart_reason": reason,
            "last_restart_returncode": result.returncode,
        })

    write_json(STATE_FILE, payload)


if __name__ == "__main__":
    main()
