#!/bin/sh
set -eu

PACKAGE=rtl8821au
VERSION=5.12.5.2
COMMIT=3a7cdb591b64d99d2670e455bde67c8ab338525b
ARCHIVE_SHA256=dc7877556b849a24b968be5237b30e0d0d29792e6da5d5f465ed18e1aadb7b78
ARCHIVE_URL="https://github.com/morrownr/8821au-20210708/archive/$COMMIT.tar.gz"
SOURCE_DIR="/usr/src/$PACKAGE-$VERSION"
MARKER="$SOURCE_DIR/.amnezia-source-commit"
KERNEL_VERSION=$(uname -r)

refresh_initramfs() {
  if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k "$KERNEL_VERSION"
  fi
}

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this installer as root." >&2
  exit 1
fi

for command in curl dkms make gcc bc sha256sum tar; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Required command is missing: $command" >&2
    exit 1
  fi
done

if [ ! -d "/lib/modules/$KERNEL_VERSION/build" ]; then
  echo "Kernel headers are missing for $KERNEL_VERSION." >&2
  exit 1
fi

if [ -f "$MARKER" ] && [ "$(cat "$MARKER")" = "$COMMIT" ]; then
  if dkms status -m "$PACKAGE" -v "$VERSION" -k "$KERNEL_VERSION" 2>/dev/null | grep -q 'installed'; then
    refresh_initramfs
    echo "Archer driver $PACKAGE/$VERSION is already installed for $KERNEL_VERSION."
    exit 0
  fi

  dkms install -m "$PACKAGE" -v "$VERSION" -k "$KERNEL_VERSION"
  refresh_initramfs
  echo "Archer driver installed for $KERNEL_VERSION."
  exit 0
fi

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT INT TERM
archive="$work_dir/source.tar.gz"

curl -fL --retry 3 "$ARCHIVE_URL" -o "$archive"
printf "%s  %s\n" "$ARCHIVE_SHA256" "$archive" | sha256sum -c -

dkms remove -m "$PACKAGE" -v "$VERSION" --all >/dev/null 2>&1 || true
rm -rf "$SOURCE_DIR"
mkdir -p "$SOURCE_DIR"
tar -xzf "$archive" --strip-components=1 -C "$SOURCE_DIR"
printf "%s\n" "$COMMIT" > "$MARKER"

dkms add -m "$PACKAGE" -v "$VERSION"
dkms build -m "$PACKAGE" -v "$VERSION" -k "$KERNEL_VERSION"
dkms install -m "$PACKAGE" -v "$VERSION" -k "$KERNEL_VERSION"
depmod -a "$KERNEL_VERSION"
refresh_initramfs

module_path=$(find "/lib/modules/$KERNEL_VERSION" -type f -name '8821au.ko*' -print -quit)
if [ -z "$module_path" ]; then
  echo "DKMS completed but 8821au.ko was not installed." >&2
  exit 1
fi

if ! modinfo "$module_path" | grep -qi 'usb:v2357p011E'; then
  echo "Installed driver does not contain the Archer T2U Nano USB ID." >&2
  exit 1
fi

echo "Archer driver installed: $module_path"
