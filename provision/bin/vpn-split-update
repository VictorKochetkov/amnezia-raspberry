#!/bin/sh
set -eu

DOMAINS_FILE=${DOMAINS_FILE:-/etc/vpn-split-domains.txt}
NFT=${NFT:-/usr/sbin/nft}

if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

while IFS= read -r domain; do
  entry="$(printf "%s" "$domain" | awk '{$1=$1; print}')"
  case "$entry" in
    ""|\#*) continue ;;
  esac
  case "$entry" in
    *[!0-9.]*)
      timeout 8 getent ahostsv4 "$entry" | awk '{print $1}' || true
      ;;
    *)
      printf "%s\n" "$entry"
      ;;
  esac
done < "$DOMAINS_FILE" | sort -u > "$tmp"

"$NFT" flush set inet vpn_router vpn4

while IFS= read -r ip; do
  [ -n "$ip" ] || continue
  "$NFT" add element inet vpn_router vpn4 "{ $ip }"
done < "$tmp"

echo "vpn4 set updated:"
"$NFT" list set inet vpn_router vpn4
