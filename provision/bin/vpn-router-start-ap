#!/bin/sh
set -eu

CONNECTION=${1:-${AP_CONNECTION:-}}
if [ -z "$CONNECTION" ]; then
  CONNECTION=$(nmcli -t -f NAME,TYPE connection show | while IFS=: read -r name type; do
    [ "$type" = "802-11-wireless" ] || continue
    mode=$(nmcli -g 802-11-wireless.mode connection show "$name" 2>/dev/null || true)
    if [ "$mode" = "ap" ]; then
      printf "%s\n" "$name"
      break
    fi
  done)
fi

if [ -z "$CONNECTION" ]; then
  echo "No Wi-Fi AP connection found." >&2
  exit 1
fi

sudo /usr/local/sbin/vpn-router-configure-ap-security "$CONNECTION"
sudo /usr/local/sbin/vpn-router-wifi-channel "$CONNECTION" || true
sudo nmcli connection down "$CONNECTION" || true
sleep 2
sudo nmcli connection up "$CONNECTION"
echo "AP is up: $CONNECTION"
echo "Clients will use 10.42.0.0/24."
