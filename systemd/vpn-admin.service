[Unit]
Description=VPN router admin UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DOMAINS_FILE=/etc/vpn-split-domains.txt
Environment=VPN_ADMIN_WIFI_IFACE=@WIFI_IFACE@
Environment=VPN_UPSTREAM_IFACE=@UPSTREAM_IFACE@
Environment=VPN_ADMIN_HELPER=/usr/local/sbin/vpn-admin-helper
Environment=VPN_ADMIN_BIND=0.0.0.0
Environment=VPN_ADMIN_PORT=80
Environment=VPN_ADMIN_SYSTEM_HISTORY_FILE=/var/lib/vpn-admin-ui/system-history.json
Environment=VPN_ADMIN_SYSTEM_HISTORY_SECONDS=300
ExecStart=/usr/bin/python3 /usr/local/sbin/vpn-admin-server
Restart=on-failure
RestartSec=2
RuntimeDirectory=vpn-admin-ui
RuntimeDirectoryPreserve=yes
StateDirectory=vpn-admin-ui
User=nobody
Group=nogroup
SupplementaryGroups=video
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/amnezia/amneziawg /etc/amnezia/router-source.json /etc/amnezia/cpufreq /run/vpn-admin-ui /var/lib/vpn-admin-ui

[Install]
WantedBy=multi-user.target
