[Unit]
Description=VPN admin connection status snapshot
After=awg-quick@awg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vpn-admin-status-snapshot
RuntimeDirectory=vpn-admin
RuntimeDirectoryPreserve=yes
StateDirectory=vpn-router
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/vpn-admin /var/lib/vpn-router
