[Unit]
Description=Apply Raspberry Pi cooling fan boot configuration
After=systemd-modules-load.service
Before=vpn-admin.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vpn-admin-helper fan-apply
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/boot/firmware
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
