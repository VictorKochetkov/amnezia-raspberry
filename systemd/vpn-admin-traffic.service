[Unit]
Description=VPN admin traffic snapshot
After=nftables.service

[Service]
Type=oneshot
Environment=VPN_ADMIN_WIFI_IFACE=@WIFI_IFACE@
Environment=VPN_UPSTREAM_IFACE=@UPSTREAM_IFACE@
ExecStart=/usr/local/sbin/vpn-admin-traffic-snapshot
RuntimeDirectory=vpn-admin
RuntimeDirectoryPreserve=yes
StateDirectory=vpn-router
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/vpn-admin /var/lib/vpn-router
