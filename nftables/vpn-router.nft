#!/usr/sbin/nft -f

table inet vpn_router {
  set vpn4 {
    type ipv4_addr
    flags interval
  }

  chain prerouting {
    type filter hook prerouting priority -150; policy accept;

    iifname "@WIFI_IFACE@" ip daddr @vpn4 meta mark set 0x1
  }

  chain forward {
    type filter hook forward priority -10; policy accept;

    ct state established,related iifname "awg0" oifname "@WIFI_IFACE@" counter accept
    ct state established,related iifname "@UPSTREAM_IFACE@" oifname "@WIFI_IFACE@" counter accept
    ct state established,related accept

    iifname "@WIFI_IFACE@" ip daddr @vpn4 oifname "awg0" tcp flags syn tcp option maxseg size set 1240
    iifname "@WIFI_IFACE@" ip daddr @vpn4 oifname "awg0" counter accept
    iifname "@WIFI_IFACE@" ip daddr @vpn4 drop

    iifname "@WIFI_IFACE@" oifname "@UPSTREAM_IFACE@" counter accept
    iifname "@WIFI_IFACE@" drop
  }
}

table ip vpn_router_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    ip saddr 10.42.0.0/24 oifname "awg0" masquerade
    ip saddr 10.42.0.0/24 oifname "@UPSTREAM_IFACE@" masquerade
  }
}
